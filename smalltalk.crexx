/* =========================================================================
   SMALLTALK.CREXX  --  a Smalltalk-80 interpreter written in CREXX (Level B)

   Usage:
       crexx smalltalk.crexx -args [-L libdir] [file.st ...]
   With no file the program is read from standard input.
   ========================================================================= */
options levelb numeric_classic
import rxfnsb
import rxfloat
import rxfs
import rxsocket
import _rxsysb
namespace smalltalk expose px_node px_obj px_cls px_meth px_mk px_env px_dd,
   px_h px_str px_fl px_si px_ss px_sf sargs n_s al o_s o_f sl symtab,
   chr_oop cmap cvmap cm lk lkg gmap g_val selmap sel_n vp fl_head ast dmap

arg av = .string[]
call init
libdir = "lib"
nfiles = 0
files = .string[]
utxt = ""
ia = 1
do while ia <= av.0
  oa = av[ia]
  if oa == "-L" & ia < av.0 then do
    ia = ia + 1
    libdir = av[ia]
  end
  else if oa == "-h" | oa == "--help" then do
    say "usage: smalltalk [-L libdir] [-i] [file.st ...] [-- arg ...]"
    exit 0
  end
  else if oa == "-i" then px_si[8] = 1
  else if oa == "--" then do
    do ia = ia + 1 to av.0
      px_si[10] = px_si[10] + 1
      sargs[px_si[10]] = av[ia]
    end
  end
  else do
    nfiles = nfiles + 1
    files[nfiles] = oa
  end
  ia = ia + 1
end
call boot
libs = "kernel.st numbers.st collections.st streams.st exceptions.st extras.st structures.st regex.st system.st net.st sunit.st"
do ia = 1 to words(libs)
  lf = libdir || "/" || word(libs, ia)
  ltxt = read_file(lf)
  if ltxt == "" then do
    say "smalltalk: cannot read library file" lf
    exit 2
  end
  call file_in ltxt, word(libs, ia)
end
px_si[58] = find_class("Message")
px_si[3] = 1
if nfiles = 0 & px_si[8] = 0 then do
  do forever
    ul = read_stdin_line()
    if ul = 0 then leave
    utxt = utxt || o_s[ul % 2] || '0a'x
  end
  call file_in utxt, "stdin"
end
else do
  do ia = 1 to nfiles
    utxt = read_file(files[ia])
    if utxt == "" then do
      call outs "smalltalk: cannot read " || files[ia] || '0a'x
      px_si[1] = 1
    end
    else call file_in utxt, files[ia]
    if px_si[2] = 1 then leave
  end
end
if px_si[8] = 1 & px_si[2] = 0 then call repl_loop
call flush_out
exit px_si[1]

/* ---------------------------------------------------------------------
   Output
   --------------------------------------------------------------------- */
outs: procedure = .void
  arg s = .string
  px_ss[1] = px_ss[1] || s
  if length(px_ss[1]) > 3000 then call flush_out
  return

flush_out: procedure = .void
  rcx = .int
  if length(px_ss[1]) > 0 then do
    assembler fwrite px_si[4], px_ss[1]
    px_ss[1] = ""
  end
  assembler fflush rcx, px_si[4]
  return

/* ---------------------------------------------------------------------
   init: declare and initialise all shared state
   --------------------------------------------------------------------- */
init: procedure = .void
  px_node = .int[]
  px_obj = .int[]
  px_cls = .int[]
  px_meth = .int[]
  px_mk = .int[]
  px_env = .int[]
  px_dd = .int[]
  px_h = .int[]
  px_str = .string[]
  px_fl = .float[]
  px_si = .int[]
  px_ss = .string[]
  px_sf = .float[]
  px_si[1] = 0
  px_si[2] = 0
  px_si[3] = 0
  px_ss[1] = ""
  px_si[4] = _open("stdout", "w")
  px_si[5] = _open("stdin", "r")
  px_si[6] = 0
  px_si[7] = 12345
  px_si[8] = 0
  px_si[9] = 0
  px_si[10] = 0
  sargs = .string[]
  px_si[11] = 0
  px_ss[2] = ""
  px_ss[3] = "add sub mul div idiv mod quo rem lt gt le ge eq ne ident nident class basicSize basicAt basicAtPut instVarAt instVarAtPut identityHash perform performWithArgs isKindOf isMemberOf respondsTo shallowCopy basicNew basicNewSize floatOp truncated floor ceiling rounded asFloat bitAnd bitOr bitXor bitShift printString printRadix isInteger isFloat isString isSymbol isCharacter isNumber sqrtFloor strSize strAt strAtPut strCat strCopy strEq strLt strHash asSymbol asString upper lower strIndexOf strReplaceAll asNumber strTrim strSplit strReverse strNew charValue charFrom arrNew arrAt arrAtPut arrSize arrCopy arrFill arrReplace dictNew dictAt dictAtPut dictHas dictRemove dictKeys dictValues dictSize dictCopy blockValue blockValueArgs blockNumArgs whileTrue whileFalse onDo ensure ifCurtailed signal resume return retry pass outer retryUsing className superclass subclassNamed addInstVar instanceVariableNames selectors includesSelector basicNewClass compile addClassVar lookupSelector subclasses category globalAt globalAtPut globalHas transcript stdinLine stdinAtEnd msecs halt exit dnuArgs isNil evaluate displayString allSymbols excInfo bigOp floatPrint random strFind strCompare asStringOf secs format fileRead fileWrite dateStr timeStr randSeed getenv argCount argAt fileDelete fileRename fileKind dirCreate dirRemove dirList cwd chdir fileCopy fileSize sysCmd sysRc sysErr fileInString sockNew sockClose sockConnect sockConnectTls sockBind sockListen sockAccept sockSend sockRecv sockPending sockTimeout sockStatus sockError sockPeer sockLocal sockNoDelay sockShutdown"
  px_ss[4] = "+ - * / // \\ < > <= >= = ~= == ~~ , value value: value:value: value:value:value: value:value:value:value: doesNotUnderstand: printString displayString printOn: hash signal defaultAction new initialize size at: at:put: do: isKindOf: messageText description next atEnd class isNil notNil lessOrEqual: -> key printString: displayNl printNl executeStatements mustBeBoolean error:"
  /* ---- lexer / parser ---- */
  px_ss[5] = ""
  px_si[12] = 1
  px_si[13] = 0
  px_si[14] = 0
  px_ss[6] = ""
  px_si[15] = 0
  px_ss[7] = ""
  px_si[16] = 0
  px_sf[1] = 0.0
  px_si[17] = 0
  px_si[18] = 0
  px_ss[8] = ""
  px_si[19] = 0
  px_sf[2] = 0.0
  px_si[20] = 0
  px_si[21] = 0
  px_si[22] = 0
  px_ss[9] = ""
  px_si[23] = 0
  px_sf[3] = 0.0
  px_si[24] = 0
  px_si[25] = 0
  px_si[26] = 0
  px_si[27] = 0
  px_si[28] = 0
  px_si[29] = 0
  /* ---- nodes ---- */
  px_si[30] = 0
  n_s = .string[]
  px_si[31] = 0
  al = .int[]
  /* ---- resolver ---- */
  px_si[32] = 0
  px_si[33] = 0
  px_si[34] = 0
  px_si[35] = 0
  px_si[36] = 0
  px_si[37] = 0
  px_si[38] = 0
  px_si[39] = 0
  px_si[40] = 0
  px_si[41] = 0
  /* ---- objects ---- */
  px_si[42] = 0
  px_si[43] = 0
  o_s = .string[]
  o_f = .float[]
  sl = .int[]
  symtab = .stem()
  chr_oop = .int[]
  chr_oop[256] = 0
  /* ---- classes ---- */
  px_si[44] = 0
  cmap = .stem()
  cvmap = .stem()
  px_si[45] = 0
  px_si[46] = 0
  px_si[47] = 0
  px_si[48] = 0
  px_si[49] = 0
  px_si[50] = 0
  px_si[51] = 0
  px_si[52] = 0
  px_si[53] = 0
  px_si[54] = 0
  px_si[55] = 0
  px_si[56] = 0
  px_si[57] = 0
  px_si[58] = 0
  /* ---- methods ---- */
  px_si[59] = 0
  cm = .int[]
  lk = .int[]
  lkg = .int[]
  px_si[60] = 1
  /* ---- globals, selectors ---- */
  px_si[61] = 0
  gmap = .stem()
  g_val = .int[]
  px_si[62] = 0
  selmap = .stem()
  sel_n = .int[]
  /* ---- frames and stacks ---- */
  px_si[63] = 1
  vp = .int[]
  fl_head = .int[]
  px_si[64] = 0
  ast = .int[]
  ast[20000] = 0
  px_si[65] = 0
  px_si[66] = 0
  /* ---- unwinding and handlers ---- */
  px_si[67] = 0
  px_si[68] = 0
  px_si[69] = 0
  px_si[70] = 0
  px_si[71] = 0
  px_si[72] = 0
  /* ---- dictionaries ---- */
  px_si[73] = 0
  px_si[74] = 0
  dmap = .stem()
  /* ---- big integers ---- */
  px_ss[10] = ""
  px_ss[11] = ""
  px_si[75] = 0
  px_ss[12] = ""
  px_ss[13] = ""
  px_ss[14] = ""
  return

/* ---------------------------------------------------------------------
   boot: nil, true, false, the kernel classes with their object kinds
   --------------------------------------------------------------------- */
boot: procedure = .void
  tbl = .string
  e = .string
  i = .int
  c = .int
  sup = .int
  nm = .string
  sp = .string
  kd = .int
  o = .int
  /* special selectors first, so the S_ constants are their ids */
  do i = 1 to words(px_ss[4])
    c = selid(word(px_ss[4], i))
  end
  o = newobj(0, 0, 0)
  o = newobj(0, 0, 0)
  o = newobj(0, 0, 0)
  tbl = "Object/-/0 Behavior/Object/0 ClassDescription/Behavior/0 Class/ClassDescription/0"
  tbl = tbl || " Metaclass/ClassDescription/0 Boolean/Object/0 True/Boolean/0 False/Boolean/0"
  tbl = tbl || " UndefinedObject/Object/0 Magnitude/Object/0 Character/Magnitude/5 Number/Magnitude/0"
  tbl = tbl || " Integer/Number/0 SmallInteger/Integer/0 LargeInteger/Integer/7"
  tbl = tbl || " LargePositiveInteger/LargeInteger/7 LargeNegativeInteger/LargeInteger/7"
  tbl = tbl || " Float/Number/3 FloatD/Float/3 Fraction/Number/0 LookupKey/Magnitude/0 Association/LookupKey/0"
  tbl = tbl || " Collection/Object/0 SequenceableCollection/Collection/0 ArrayedCollection/SequenceableCollection/0"
  tbl = tbl || " Array/ArrayedCollection/4 CharacterArray/ArrayedCollection/0 String/CharacterArray/1 Symbol/String/2"
  tbl = tbl || " OrderedCollection/SequenceableCollection/0 SortedCollection/OrderedCollection/0"
  tbl = tbl || " Interval/ArrayedCollection/0 HashedCollection/Collection/0"
  tbl = tbl || " Dictionary/HashedCollection/8 IdentityDictionary/Dictionary/8 Set/HashedCollection/8"
  tbl = tbl || " IdentitySet/Set/8 Bag/HashedCollection/0 BlockClosure/Object/6 Message/Object/0"
  tbl = tbl || " Stream/Object/0 PositionableStream/Stream/0 ReadStream/PositionableStream/0"
  tbl = tbl || " WriteStream/PositionableStream/0 ReadWriteStream/WriteStream/0 TextCollector/Stream/0"
  tbl = tbl || " SystemDictionary/Object/0 Point/Object/0 Random/Object/0 Date/Magnitude/0 Time/Magnitude/0"
  tbl = tbl || " Signal/Object/0 Exception/Signal/0 Error/Exception/0 Warning/Exception/0"
  tbl = tbl || " ArithmeticError/Error/0 ZeroDivide/ArithmeticError/0 MessageNotUnderstood/Error/0"
  tbl = tbl || " InvalidValue/Error/0 InvalidArgument/InvalidValue/0 IndexOutOfRange/InvalidArgument/0"
  tbl = tbl || " NotFound/InvalidArgument/0 EmptyCollection/Error/0 WrongClass/InvalidValue/0"
  tbl = tbl || " InvalidReturn/Error/0 UserInterrupt/Exception/0 ExceptionSet/Object/0"
  do i = 1 to words(tbl)
    e = word(tbl, i)
    parse var e nm "/" sp "/" kd
    if sp == "-" then sup = 0
    else sup = find_class(sp)
    c = define_class(nm, sup)
    px_cls[c*8+5] = kd
    if nm == "Class" then do
      px_si[46] = c
      px_cls[(px_cls[(cmap["Object"])*8+2])*8+1] = c
    end
    if nm == "Metaclass" then px_si[47] = c
  end
  do i = 1 to px_si[44]
    if px_cls[i*8+3] = 1 then px_obj[(px_cls[i*8+8] % 2)*5+1] = px_si[47]
  end
  px_si[45] = find_class("Object")
  px_si[48] = find_class("String")
  px_si[49] = find_class("Symbol")
  px_si[50] = find_class("FloatD")
  px_si[51] = find_class("Character")
  px_si[52] = find_class("Array")
  px_si[53] = find_class("SmallInteger")
  px_si[54] = find_class("LargePositiveInteger")
  px_si[55] = find_class("LargeNegativeInteger")
  px_si[56] = find_class("BlockClosure")
  px_si[57] = find_class("UndefinedObject")
  px_si[58] = find_class("Message")
  px_obj[1*5+1] = px_si[57]
  px_obj[2*5+1] = find_class("True")
  px_obj[3*5+1] = find_class("False")
  call gset "nil", 2
  call gset "true", 4
  call gset "false", 6
  o = newobj(find_class("SystemDictionary"), 0, 0)
  call gset "Smalltalk", o
  o = newobj(find_class("TextCollector"), 0, 0)
  call gset "Transcript", o
  return


/* ---------------------------------------------------------------------
   Lexer
   --------------------------------------------------------------------- */
isletter: procedure = .int
  arg c = .string
  if c == "" then return 0
  if c >>= "a" & c <<= "z" then return 1
  if c >>= "A" & c <<= "Z" then return 1
  if c == "_" then return 1
  return 0

isdigit: procedure = .int
  arg c = .string
  if c == "" then return 0
  if c >>= "0" & c <<= "9" then return 1
  return 0

isbinch: procedure = .int
  arg c = .string
  if c == "" then return 0
  if pos(c, "+-*/\<>=~@%|&?,") > 0 then return 1
  return 0

line_of: procedure = .int
  arg p = .int
  n = .int
  i = .int
  n = 1
  i = pos('0a'x, px_ss[5])
  do while i > 0 & i < p
    n = n + 1
    i = pos('0a'x, px_ss[5], i + 1)
  end
  return n

perr: procedure = .void
  arg msg = .string
  if px_si[14] = 0 then do
    px_si[14] = 1
    call outs "Parse error (" || px_ss[6] || " line " || line_of(px_si[12]) || "): " || msg || '0a'x
  end
  return

/* scan the next token into lx_* */
lex_token: procedure = .void
  c = .string
  d = .string
  p = .int
  q = .int
  s = .string
  radix = .int
  v = .int
  ok = .int
  dg = .string
  fr = .string
  ex = .string
  isf = .int
  startp = .int
 do forever
    if px_si[12] > px_si[13] then leave
    c = substr(px_ss[5], px_si[12], 1)
    if c == " " | c == '09'x | c == '0a'x | c == '0d'x | c == '0c'x then px_si[12] = px_si[12] + 1
    else if c == '"' then do
      q = pos('"', px_ss[5], px_si[12] + 1)
      if q = 0 then px_si[12] = px_si[13] + 1
      else px_si[12] = q + 1
    end
    else leave
  end
  px_ss[8] = ""
  px_si[19] = 0
  px_sf[2] = 0.0
  px_si[20] = px_si[12]
  if px_si[12] > px_si[13] then do
    px_si[18] = 0
    return
  end
  c = substr(px_ss[5], px_si[12], 1)
  if isletter(c) = 1 then do
    q = px_si[12]
    do while q <= px_si[13] & (isletter(substr(px_ss[5], q, 1)) = 1 | isdigit(substr(px_ss[5], q, 1)) = 1)
      q = q + 1
    end
    /* namespace dots:  Foo.Bar */
    do while q < px_si[13] & substr(px_ss[5], q, 1) == "." & isletter(substr(px_ss[5], q + 1, 1)) = 1 & substr(px_ss[5], px_si[12], 1) >>= "A" & substr(px_ss[5], px_si[12], 1) <<= "Z" & substr(px_ss[5], q + 1, 1) >>= "A" & substr(px_ss[5], q + 1, 1) <<= "Z"
      q = q + 1
      do while q <= px_si[13] & (isletter(substr(px_ss[5], q, 1)) = 1 | isdigit(substr(px_ss[5], q, 1)) = 1)
        q = q + 1
      end
    end
    s = substr(px_ss[5], px_si[12], q - px_si[12])
    if substr(px_ss[5], q, 1) == ":" & substr(px_ss[5], q + 1, 1) \== "=" then do
      px_si[18] = 2
      px_ss[8] = s || ":"
      px_si[12] = q + 1
      return
    end
    px_si[18] = 1
    p = lastpos(".", s)
    if p > 0 then s = substr(s, p + 1)
    px_ss[8] = s
    px_si[12] = q
    return
  end
  if isdigit(c) = 1 then do
    call lex_number
    return
  end
  if c == "'" then do
    s = ""
    q = px_si[12] + 1
    do forever
      p = pos("'", px_ss[5], q)
      if p = 0 then do
        s = s || substr(px_ss[5], q)
        px_si[12] = px_si[13] + 1
        leave
      end
      s = s || substr(px_ss[5], q, p - q)
      if substr(px_ss[5], p + 1, 1) == "'" then do
        s = s || "'"
        q = p + 2
      end
      else do
        px_si[12] = p + 1
        leave
      end
    end
    px_si[18] = 6
    px_ss[8] = s
    return
  end
  if c == "$" then do
    px_si[18] = 8
    px_si[19] = c2d(substr(px_ss[5], px_si[12] + 1, 1))
    px_si[12] = px_si[12] + 2
    return
  end
  if c == "#" then do
    d = substr(px_ss[5], px_si[12] + 1, 1)
    if d == "(" then do
      px_si[18] = 21
      px_si[12] = px_si[12] + 2
      return
    end
    if d == "[" then do
      px_si[18] = 22
      px_si[12] = px_si[12] + 2
      return
    end
    if d == "'" then do
      px_si[12] = px_si[12] + 1
      call lex_token
      px_si[18] = 7
      return
    end
    if d == "#" then do
      px_si[12] = px_si[12] + 1
      call lex_token
      return
    end
    if isletter(d) = 1 then do
      q = px_si[12] + 1
      do while q <= px_si[13] & (isletter(substr(px_ss[5], q, 1)) = 1 | isdigit(substr(px_ss[5], q, 1)) = 1 | substr(px_ss[5], q, 1) == ":" | (substr(px_ss[5], q, 1) == "." & isletter(substr(px_ss[5], q + 1, 1)) = 1))
        q = q + 1
      end
      px_si[18] = 7
      px_ss[8] = substr(px_ss[5], px_si[12] + 1, q - px_si[12] - 1)
      px_si[12] = q
      return
    end
    if isbinch(d) = 1 then do
      q = px_si[12] + 1
      do while q <= px_si[13] & isbinch(substr(px_ss[5], q, 1)) = 1
        q = q + 1
      end
      px_si[18] = 7
      px_ss[8] = substr(px_ss[5], px_si[12] + 1, q - px_si[12] - 1)
      px_si[12] = q
      return
    end
    px_si[18] = 3
    px_ss[8] = "#"
    px_si[12] = px_si[12] + 1
    return
  end
  px_si[12] = px_si[12] + 1
  select
    when c == ":" then do
      if substr(px_ss[5], px_si[12], 1) == "=" then do
        px_si[12] = px_si[12] + 1
        px_si[18] = 9
      end
      else px_si[18] = 19
      return
    end
    when c == "^" then px_si[18] = 10
    when c == "(" then px_si[18] = 11
    when c == ")" then px_si[18] = 12
    when c == "[" then px_si[18] = 13
    when c == "]" then px_si[18] = 14
    when c == "{" then px_si[18] = 15
    when c == "}" then px_si[18] = 16
    when c == "." then px_si[18] = 17
    when c == ";" then px_si[18] = 18
    when c == "!" then px_si[18] = 20
    otherwise do
      px_si[18] = 3
      s = c
      do while px_si[12] <= px_si[13] & isbinch(substr(px_ss[5], px_si[12], 1)) = 1
        s = s || substr(px_ss[5], px_si[12], 1)
        px_si[12] = px_si[12] + 1
      end
      if length(s) > 1 & right(s, 1) == "-" & isdigit(substr(px_ss[5], px_si[12], 1)) = 1 then do
        s = left(s, length(s) - 1)
        px_si[12] = px_si[12] - 1
      end
      px_ss[8] = s
    end
  end
  return

lex_number: procedure = .void
  q = .int
  p = .int
  dg = .string
  fr = .string
  ex = .string
  radix = .int
  v = .int
  c = .string
  isf = .int
  neg = .int
  q = px_si[12]
  do while q <= px_si[13] & isdigit(substr(px_ss[5], q, 1)) = 1
    q = q + 1
  end
  dg = substr(px_ss[5], px_si[12], q - px_si[12])
  if substr(px_ss[5], q, 1) == "r" & (isdigit(substr(px_ss[5], q + 1, 1)) = 1 | (substr(px_ss[5], q + 1, 1) >>= "A" & substr(px_ss[5], q + 1, 1) <<= "Z")) then do
    radix = dg as .int
    q = q + 1
    v = 0
    do while q <= px_si[13]
      c = substr(px_ss[5], q, 1)
      if isdigit(c) = 1 then p = c as .int
      else if c >>= "A" & c <<= "Z" then p = c2d(c) - 55
      else leave
      if p >= radix then leave
      v = v * radix + p
      q = q + 1
    end
    px_si[18] = 4
    px_si[19] = v
    px_si[12] = q
    return
  end
  fr = ""
  isf = 0
  if substr(px_ss[5], q, 1) == "." & isdigit(substr(px_ss[5], q + 1, 1)) = 1 then do
    isf = 1
    p = q + 1
    do while p <= px_si[13] & isdigit(substr(px_ss[5], p, 1)) = 1
      p = p + 1
    end
    fr = substr(px_ss[5], q + 1, p - q - 1)
    q = p
  end
  ex = ""
  c = substr(px_ss[5], q, 1)
  if c == "e" | c == "d" | c == "q" then do
    p = q + 1
    neg = 0
    if substr(px_ss[5], p, 1) == "-" then do
      neg = 1
      p = p + 1
    end
    if isdigit(substr(px_ss[5], p, 1)) = 1 then do
      v = p
      do while v <= px_si[13] & isdigit(substr(px_ss[5], v, 1)) = 1
        v = v + 1
      end
      ex = substr(px_ss[5], p, v - p)
      if neg = 1 then do
        ex = "-" || ex
        isf = 1
      end
      q = v
    end
  end
  /* scaled decimal 1.5s2 : treated as float */
  if substr(px_ss[5], q, 1) == "s" & isdigit(substr(px_ss[5], q + 1, 1)) = 1 & isf = 1 then do
    q = q + 1
    do while q <= px_si[13] & isdigit(substr(px_ss[5], q, 1)) = 1
      q = q + 1
    end
  end
  px_si[12] = q
  if isf = 1 then do
    px_si[18] = 5
    if fr == "" then fr = "0"
    if ex == "" then px_sf[2] = (dg || "." || fr) as .float
    else px_sf[2] = (dg || "." || fr || "E" || ex) as .float
    return
  end
  if ex \== "" & ex \== "0" then dg = dg || copies("0", ex as .int)
  if length(dg) > 18 then do
    px_si[18] = 23
    px_ss[8] = dg
    return
  end
  px_si[18] = 4
  px_si[19] = dg as .int
  return

/* token stream with one token of lookahead */
advance: procedure = .void
  if px_si[21] = 1 then do
    px_si[15] = px_si[22]
    px_ss[7] = px_ss[9]
    px_si[16] = px_si[23]
    px_sf[1] = px_sf[3]
    px_si[17] = px_si[24]
    px_si[21] = 0
  end
  else do
    call lex_token
    px_si[15] = px_si[18]
    px_ss[7] = px_ss[8]
    px_si[16] = px_si[19]
    px_sf[1] = px_sf[2]
    px_si[17] = px_si[20]
  end
  return

peek_tok: procedure = .void
  if px_si[21] = 0 then do
    call lex_token
    px_si[22] = px_si[18]
    px_ss[9] = px_ss[8]
    px_si[23] = px_si[19]
    px_sf[3] = px_sf[2]
    px_si[24] = px_si[20]
    px_si[21] = 1
  end
  return

/* save / restore the whole lexer state (for backtracking) */
lex_mark: procedure = .int
  px_si[25] = px_si[25] + 1
  px_mk[(px_si[25])*8+1] = px_si[12]
  px_mk[(px_si[25])*8+2] = px_si[15]
  px_str[(px_si[25])*8+1] = px_ss[7]
  px_mk[(px_si[25])*8+3] = px_si[16]
  px_fl[(px_si[25])*2+1] = px_sf[1]
  px_mk[(px_si[25])*8+4] = px_si[17]
  px_mk[(px_si[25])*8+5] = px_si[21]
  px_mk[(px_si[25])*8+6] = px_si[22]
  px_str[(px_si[25])*8+2] = px_ss[9]
  px_mk[(px_si[25])*8+7] = px_si[23]
  px_fl[(px_si[25])*2+2] = px_sf[3]
  px_mk[(px_si[25])*8+8] = px_si[24]
  return px_si[25]

lex_reset: procedure = .void
  arg m = .int
  px_si[12] = px_mk[m*8+1]
  px_si[15] = px_mk[m*8+2]
  px_ss[7] = px_str[m*8+1]
  px_si[16] = px_mk[m*8+3]
  px_sf[1] = px_fl[m*2+1]
  px_si[17] = px_mk[m*8+4]
  px_si[21] = px_mk[m*8+5]
  px_si[22] = px_mk[m*8+6]
  px_ss[9] = px_str[m*8+2]
  px_si[23] = px_mk[m*8+7]
  px_sf[3] = px_fl[m*2+2]
  px_si[24] = px_mk[m*8+8]
  px_si[25] = m - 1
  return

lex_drop: procedure = .void
  arg m = .int
  px_si[25] = m - 1
  return

/* ---------------------------------------------------------------------
   Raw syntax tree
   --------------------------------------------------------------------- */
nd: procedure = .int
  arg t = .int, a = .int, b = .int, c = .int, d = .int, i = .int, s = .string
  px_si[30] = px_si[30] + 1
  px_node[(px_si[30])*6+1] = t
  px_node[(px_si[30])*6+2] = a
  px_node[(px_si[30])*6+3] = b
  px_node[(px_si[30])*6+4] = c
  px_node[(px_si[30])*6+5] = d
  px_node[(px_si[30])*6+6] = i
  n_s[px_si[30]] = s
  return px_si[30]

isbin: procedure = .int
  arg s = .string
  if px_si[15] = 3 & px_ss[7] == s then return 1
  return 0

/* statements until the closing token; returns an 14 node */
parse_stmts: procedure = .int
  arg endt = .int
  first = .int
  n = .int
  st = .int
  tmp = .int[]
  n = 0
  do forever
    do while px_si[15] = 17
      call advance
    end
    if px_si[15] = endt | px_si[15] = 0 | px_si[14] = 1 then leave
    if endt = 14 & px_si[15] = 20 then leave
    st = parse_statement()
    n = n + 1
    tmp[n] = st
    if px_si[15] = 17 then call advance
    else leave
  end
  first = px_si[31] + 1
  do st = 1 to n
    px_si[31] = px_si[31] + 1
    al[px_si[31]] = tmp[st]
  end
  return nd(14, first, n, 0, 0, 0, "")

parse_statement: procedure = .int
  e = .int
  if px_si[15] = 10 then do
    call advance
    e = parse_expr()
    return nd(45, e, 0, 0, 0, 0, "")
  end
  return parse_expr()

parse_expr: procedure = .int
  nme = .string
  e = .int
  if px_si[15] = 1 then do
    call peek_tok
    if px_si[22] = 9 then do
      nme = px_ss[7]
      call advance
      call advance
      e = parse_expr()
      return nd(41, e, 0, 0, 0, 0, nme)
    end
  end
  e = parse_keyword_expr()
  if px_si[15] = 18 then e = parse_cascade(e)
  return e

parse_cascade: procedure = .int
  arg e0 = .int
  rcv = .int
  first = .int
  n = .int
  m = .int
  tmp = .int[]
  if px_node[e0*6+1] \= 42 then do
    call perr "cascade needs a message send"
    return e0
  end
  rcv = px_node[e0*6+2]
  /* the first message is the one already parsed */
  n = 1
  tmp[1] = nd(46, 0, px_node[e0*6+3], 0, px_node[e0*6+5], px_node[e0*6+6], n_s[e0])
  do while px_si[15] = 18 & px_si[14] = 0
    call advance
    n = n + 1
    tmp[n] = parse_msg_part()
  end
  first = px_si[31] + 1
  do m = 1 to n
    px_si[31] = px_si[31] + 1
    al[px_si[31]] = tmp[m]
  end
  return nd(43, rcv, first, n, 0, 0, "")

/* one message (unary, binary or keyword) without a receiver */
parse_msg_part: procedure = .int
  a = .int
  sel = .string
  first = .int
  n = .int
  m = .int
  tmp = .int[]
  if px_si[15] = 1 then do
    sel = px_ss[7]
    call advance
    return nd(46, 0, 0, 0, 0, 0, sel)
  end
  if px_si[15] = 3 then do
    sel = px_ss[7]
    call advance
    a = parse_unary_expr()
    first = px_si[31] + 1
    px_si[31] = px_si[31] + 1
    al[px_si[31]] = a
    return nd(46, 0, first, 0, 0, 1, sel)
  end
  if px_si[15] = 2 then do
    sel = ""
    n = 0
    do while px_si[15] = 2 & px_si[14] = 0
      sel = sel || px_ss[7]
      call advance
      n = n + 1
      tmp[n] = parse_binary_expr()
    end
    first = px_si[31] + 1
    do m = 1 to n
      px_si[31] = px_si[31] + 1
      al[px_si[31]] = tmp[m]
    end
    return nd(46, 0, first, 0, 0, n, sel)
  end
  call perr "bad cascade message"
  return nd(46, 0, 0, 0, 0, 0, "yourself")

parse_keyword_expr: procedure = .int
  rcv = .int
  sel = .string
  first = .int
  n = .int
  m = .int
  sup = .int
  tmp = .int[]
  rcv = parse_binary_expr()
  if px_si[15] \= 2 then return rcv
  sup = px_node[rcv*6+5]
  if px_node[rcv*6+1] = 40 & n_s[rcv] == "super" then sup = 1
  sel = ""
  n = 0
  do while px_si[15] = 2 & px_si[14] = 0
    sel = sel || px_ss[7]
    call advance
    n = n + 1
    tmp[n] = parse_binary_expr()
  end
  first = px_si[31] + 1
  do m = 1 to n
    px_si[31] = px_si[31] + 1
    al[px_si[31]] = tmp[m]
  end
  return mk_send(rcv, sel, first, n)

mk_send: procedure = .int
  arg rcv = .int, sel = .string, first = .int, n = .int
  sup = .int
  sup = 0
  if px_node[rcv*6+1] = 40 & n_s[rcv] == "super" then sup = 1
  return nd(42, rcv, first, 0, sup, n, sel)

parse_binary_expr: procedure = .int
  rcv = .int
  a = .int
  sel = .string
  first = .int
  rcv = parse_unary_expr()
  do while px_si[15] = 3 & px_si[14] = 0
    sel = px_ss[7]
    call advance
    a = parse_unary_expr()
    first = px_si[31] + 1
    px_si[31] = px_si[31] + 1
    al[px_si[31]] = a
    rcv = mk_send(rcv, sel, first, 1)
  end
  return rcv

parse_unary_expr: procedure = .int
  rcv = .int
  rcv = parse_primary()
  do while px_si[15] = 1 & px_si[14] = 0
    call peek_tok
    if px_si[22] = 9 then leave
    rcv = mk_send(rcv, px_ss[7], 0, 0)
    call advance
  end
  return rcv

parse_primary: procedure = .int
  s = .string
  e = .int
  t = .int
  o = .int
  if px_si[15] = 1 then do
    s = px_ss[7]
    call advance
    if s == "nil" then return nd(1, 2, 0, 0, 0, 0, "")
    if s == "true" then return nd(1, 4, 0, 0, 0, 0, "")
    if s == "false" then return nd(1, 6, 0, 0, 0, 0, "")
    if s == "thisContext" then return nd(16, 0, 0, 0, 0, 0, "")
    return nd(40, 0, 0, 0, 0, 0, s)
  end
  if px_si[15] = 4 then do
    o = mkint(px_si[16])
    call advance
    return nd(1, o, 0, 0, 0, 0, "")
  end
  if px_si[15] = 23 then do
    o = mkbig(px_ss[7])
    call advance
    return nd(1, o, 0, 0, 0, 0, "")
  end
  if px_si[15] = 5 then do
    o = mkfloat(px_sf[1])
    call advance
    return nd(1, o, 0, 0, 0, 0, "")
  end
  if px_si[15] = 6 then do
    o = mkstr(px_ss[7])
    call advance
    return nd(1, o, 0, 0, 0, 0, "")
  end
  if px_si[15] = 7 then do
    o = mksym(px_ss[7])
    call advance
    return nd(1, o, 0, 0, 0, 0, "")
  end
  if px_si[15] = 8 then do
    o = mkchar(px_si[16])
    call advance
    return nd(1, o, 0, 0, 0, 0, "")
  end
  if px_si[15] = 21 then do
    call advance
    o = parse_litarray()
    return nd(1, o, 0, 0, 0, 0, "")
  end
  if px_si[15] = 22 then do
    call advance
    o = parse_bytearray()
    return nd(1, o, 0, 0, 0, 0, "")
  end
  if px_si[15] = 11 then do
    call advance
    e = parse_expr()
    if px_si[15] = 12 then call advance
    else call perr "missing )"
    return e
  end
  if px_si[15] = 13 then return parse_block()
  if px_si[15] = 15 then return parse_brace()
  if px_si[15] = 3 & px_ss[7] == "-" then do
    /* negative literal */
    call peek_tok
    if px_si[22] = 4 | px_si[22] = 5 | px_si[22] = 23 then do
      if px_si[24] = px_si[17] + 1 then do
        call advance
        if px_si[15] = 4 then o = mkint(0 - px_si[16])
        else if px_si[15] = 5 then o = mkfloat(0.0 - px_sf[1])
        else o = mkbig("-" || px_ss[7])
        call advance
        return nd(1, o, 0, 0, 0, 0, "")
      end
    end
  end
  call perr "expression expected, found '" || px_ss[7] || "'"
  call advance
  return nd(1, 2, 0, 0, 0, 0, "")

parse_brace: procedure = .int
  first = .int
  n = .int
  m = .int
  e = .int
  tmp = .int[]
  call advance
  n = 0
  do forever
    do while px_si[15] = 17
      call advance
    end
    if px_si[15] = 16 | px_si[15] = 0 | px_si[14] = 1 then leave
    e = parse_expr()
    n = n + 1
    tmp[n] = e
    if px_si[15] = 17 then call advance
    else leave
  end
  if px_si[15] = 16 then call advance
  else call perr "missing }"
  first = px_si[31] + 1
  do m = 1 to n
    px_si[31] = px_si[31] + 1
    al[px_si[31]] = tmp[m]
  end
  return nd(15, first, n, 0, 0, 0, "")

/* literal array contents after #( or ( */
parse_litarray: procedure = .int
  n = .int
  m = .int
  o = .int
  arr = .int
  v = .int
  tmp = .int[]
  n = 0
  do forever
    if px_si[15] = 12 | px_si[15] = 0 | px_si[14] = 1 then leave
    v = parse_litelem()
    n = n + 1
    tmp[n] = v
  end
  if px_si[15] = 12 then call advance
  else call perr "missing ) in literal array"
  arr = mkarray(n)
  do m = 1 to n
    call slot_put arr, m - 1, tmp[m]
  end
  return arr

parse_litelem: procedure = .int
  o = .int
  s = .string
  if px_si[15] = 4 then do
    o = mkint(px_si[16])
    call advance
    return o
  end
  if px_si[15] = 23 then do
    o = mkbig(px_ss[7])
    call advance
    return o
  end
  if px_si[15] = 5 then do
    o = mkfloat(px_sf[1])
    call advance
    return o
  end
  if px_si[15] = 6 then do
    o = mkstr(px_ss[7])
    call advance
    return o
  end
  if px_si[15] = 7 then do
    o = mksym(px_ss[7])
    call advance
    return o
  end
  if px_si[15] = 8 then do
    o = mkchar(px_si[16])
    call advance
    return o
  end
  if px_si[15] = 21 | px_si[15] = 11 then do
    call advance
    return parse_litarray()
  end
  if px_si[15] = 22 | px_si[15] = 13 then do
    call advance
    return parse_bytearray()
  end
  if px_si[15] = 15 then do
    call advance
    return parse_litarray2()
  end
  if px_si[15] = 1 then do
    s = px_ss[7]
    call advance
    if s == "nil" then return 2
    if s == "true" then return 4
    if s == "false" then return 6
    return mksym(s)
  end
  if px_si[15] = 2 then do
    s = px_ss[7]
    call advance
    do while px_si[15] = 2
      s = s || px_ss[7]
      call advance
    end
    return mksym(s)
  end
  if px_si[15] = 3 then do
    s = px_ss[7]
    call advance
    if s == "-" & (px_si[15] = 4 | px_si[15] = 5) then do
      if px_si[15] = 4 then o = mkint(0 - px_si[16])
      else o = mkfloat(0.0 - px_sf[1])
      call advance
      return o
    end
    return mksym(s)
  end
  call perr "bad literal array element"
  call advance
  return 2

parse_litarray2: procedure = .int
  /* {...} inside a literal array: treated as an array of its elements until } */
  n = .int
  m = .int
  arr = .int
  v = .int
  tmp = .int[]
  n = 0
  do while px_si[15] \= 16 & px_si[15] \= 0 & px_si[14] = 0
    v = parse_litelem()
    n = n + 1
    tmp[n] = v
  end
  if px_si[15] = 16 then call advance
  arr = mkarray(n)
  do m = 1 to n
    call slot_put arr, m - 1, tmp[m]
  end
  return arr

parse_bytearray: procedure = .int
  n = .int
  m = .int
  arr = .int
  tmp = .int[]
  n = 0
  do while px_si[15] = 4
    n = n + 1
    tmp[n] = mkint(px_si[16])
    call advance
  end
  if px_si[15] = 14 then call advance
  else call perr "missing ] in byte array"
  arr = mkarray(n)
  do m = 1 to n
    call slot_put arr, m - 1, tmp[m]
  end
  return arr

/* [ :a :b | | t | stmts ] */
parse_block: procedure = .int
  np = .int
  nt2 = .int
  first_p = .int
  first_t = .int
  body = .int
  call advance
  np = 0
  first_p = px_si[29] + 1
  do while px_si[15] = 19
    call advance
    if px_si[15] = 1 then do
      px_si[29] = px_si[29] + 1
      px_str[(px_si[29])*8+3] = px_ss[7]
      np = np + 1
      call advance
    end
    else call perr "block parameter name expected"
  end
  if np > 0 then do
    if isbin("|") = 1 then call advance
    else if isbin("||") = 1 then do
      /* [:a || t | ...]  -- the second bar opens a temporaries list */
      px_ss[7] = "|"
    end
    else if px_si[15] \= 14 then call perr "| expected after block parameters"
  end
  first_t = px_si[29] + 1
  nt2 = parse_temps()
  body = parse_stmts(14)
  if px_si[15] = 14 then call advance
  else call perr "missing ]"
  return nd(44, body, first_p, np, first_t, nt2, "")

/* | a b c |  (returns the count; names are appended to nl_name) */
parse_temps: procedure = .int
  n = .int
  n = 0
  do while isbin("|") = 1 | isbin("||") = 1
    if isbin("||") = 1 then call advance
    else do
      call advance
      do while px_si[15] = 1
        px_si[29] = px_si[29] + 1
        px_str[(px_si[29])*8+3] = px_ss[7]
        n = n + 1
        call advance
      end
      if isbin("|") = 1 then call advance
      else call perr "| expected after temporaries"
    end
  end
  return n


/* ---------------------------------------------------------------------
   Methods, classes and the file-in loop
   --------------------------------------------------------------------- */
skip_pragma: procedure = .void
  /* at the "<" of a pragma */
  nme = .string
  call advance
  if px_si[15] = 2 & px_ss[7] == "primitive:" then do
    call advance
    if px_si[15] = 1 then do
      px_si[26] = wordpos(px_ss[7], px_ss[3])
      if px_si[26] = 0 then call perr "unknown primitive " || px_ss[7]
    end
    else if px_si[15] = 4 then px_si[26] = px_si[16]
    call advance
  end
  do while px_si[15] \= 0 & isbin(">") = 0
    call advance
  end
  if px_si[15] \= 0 then call advance
  return

/* method body after the "[": temps, pragmas, statements, up to "]" */
parse_method_body: procedure = .int
  body = .int
  px_si[26] = 0
  px_si[27] = px_si[29] + 1
  px_si[28] = 0
  do forever
    if isbin("|") = 1 | isbin("||") = 1 then px_si[28] = px_si[28] + parse_temps()
    else if isbin("<") = 1 then call skip_pragma
    else leave
  end
  body = parse_stmts(14)
  if px_si[15] = 14 then call advance
  else call perr "missing ] at end of method"
  return body

/* parse "pattern [ body ]" and install it in class c */
parse_method_def: procedure = .void
  arg c = .int
  sel = .string
  np = .int
  pfirst = .int
  body = .int
  tfirst = .int
  ntemps = .int
  prim = .int
  startp = .int
  startp = px_si[17]
  sel = ""
  np = 0
  pfirst = px_si[29] + 1
  if px_si[15] = 1 then do
    sel = px_ss[7]
    call advance
  end
  else if px_si[15] = 3 then do
    sel = px_ss[7]
    call advance
    if px_si[15] = 1 then do
      px_si[29] = px_si[29] + 1
      px_str[(px_si[29])*8+3] = px_ss[7]
      np = 1
      call advance
    end
    else call perr "binary method parameter expected"
  end
  else if px_si[15] = 2 then do
    do while px_si[15] = 2
      sel = sel || px_ss[7]
      call advance
      if px_si[15] = 1 then do
        px_si[29] = px_si[29] + 1
        px_str[(px_si[29])*8+3] = px_ss[7]
        np = np + 1
        call advance
      end
      else call perr "keyword method parameter expected"
    end
  end
  else do
    call perr "method pattern expected"
    call advance
    return
  end
  if px_si[15] \= 13 then do
    call perr "[ expected after method pattern " || sel
    return
  end
  call advance
  body = parse_method_body()
  if px_si[14] = 1 then return
  tfirst = px_si[27]
  ntemps = px_si[28]
  prim = px_si[26]
  call compile_method c, sel, pfirst, np, tfirst, ntemps, body, prim, startp
  return

/* items inside  Foo subclass: Bar [ ... ]  (cnum is the class) */
parse_class_body: procedure = .void
  arg cnum = .int
  nme = .string
  c2 = .int
  o = .int
  e = .int
  m = .int
  do forever
    if px_si[15] = 14 | px_si[15] = 0 | px_si[14] = 1 then leave
    if px_si[15] = 17 then do
      call advance
      iterate
    end
    if (isbin("|") = 1 | isbin("||") = 1) & pattern_follows() = 0 then do
      do while isbin("|") = 1 | isbin("||") = 1
        if isbin("||") = 1 then call advance
        else do
          call advance
          do while px_si[15] = 1
            call add_ivar cnum, px_ss[7]
            call advance
          end
          if isbin("|") = 1 then call advance
          else call perr "| expected"
        end
      end
      iterate
    end
    if isbin("<") = 1 & pattern_follows() = 0 then do
      px_si[26] = 0
      call skip_pragma
      iterate
    end
    if px_si[15] = 1 then do
      call peek_tok
      if px_si[22] = 9 then do
        nme = px_ss[7]
        call advance
        call advance
        e = parse_expr()
        if px_si[15] = 17 then call advance
        if px_si[14] = 0 then call define_classvar cnum, nme, e
        iterate
      end
      if px_si[22] = 1 & px_ss[9] == "class" then do
        /* Foo class >> sel [ ]   or   Foo class [ | a | ] */
        nme = px_ss[7]
        m = lex_mark()
        call advance
        call advance
        if isbin(">>") = 1 then do
          call lex_drop m
          call advance
          c2 = find_class(nme)
          if c2 = 0 then do
            call perr "unknown class " || nme
            leave
          end
          call parse_method_def px_cls[c2*8+2]
          iterate
        end
        if px_si[15] = 13 then do
          call lex_drop m
          call advance
          c2 = find_class(nme)
          if c2 = 0 then do
            call perr "unknown class " || nme
            leave
          end
          call parse_class_body px_cls[c2*8+2]
          iterate
        end
        call lex_reset m
      end
      if px_si[22] = 3 & px_ss[9] == ">>" then do
        nme = px_ss[7]
        call advance
        call advance
        c2 = find_class(nme)
        if c2 = 0 then do
          call perr "unknown class " || nme
          leave
        end
        call parse_method_def c2
        iterate
      end
    end
    call parse_method_def cnum
  end
  if px_si[15] = 14 then call advance
  return

/* "Foo class [ | a b | ]" and "Foo class extend [ ... ]" style bodies for the metaclass */
parse_meta_body: procedure = .void
  arg cnum = .int
  call parse_class_body px_cls[cnum*8+2]
  return

/* is the token sequence at the mark "pattern [" ? (used to spot Foo >> sel [ ) */
pattern_follows: procedure = .int
  m = .int
  ok = .int
  m = lex_mark()
  ok = 0
  if px_si[15] = 1 then do
    call advance
    if px_si[15] = 13 then ok = 1
  end
  else if px_si[15] = 3 then do
    call advance
    if px_si[15] = 1 then do
      call advance
      if px_si[15] = 13 then ok = 1
    end
  end
  else if px_si[15] = 2 then do
    do while px_si[15] = 2
      call advance
      if px_si[15] = 1 then call advance
      else leave
    end
    if px_si[15] = 13 then ok = 1
  end
  call lex_reset m
  return ok

/* process one top-level construct; returns after consuming it */
top_item: procedure = .void
  m = .int
  nme = .string
  sup = .string
  cn = .int
  sc = .int
  st = .int
  n = .int
  e = .int
  if px_si[15] = 1 & px_ss[7] == "Eval" then do
    call peek_tok
    if px_si[22] = 13 then do
      call advance
      call advance
      do forever
        do while px_si[15] = 17
          call advance
        end
        if px_si[15] = 14 | px_si[15] = 0 | px_si[14] = 1 then leave
        if isbin("|") = 1 | isbin("||") = 1 then do
          n = parse_temps()
          iterate
        end
        st = parse_statement()
        if px_si[14] = 0 then call run_doit st
        if px_si[15] = 17 then call advance
      end
      if px_si[15] = 14 then call advance
      return
    end
  end
  if px_si[15] = 1 then do
    m = lex_mark()
    nme = px_ss[7]
    call advance
    if px_si[15] = 2 & px_ss[7] == "subclass:" then do
      call advance
      if px_si[15] = 1 then do
        sup = nme
        nme = px_ss[7]
        call advance
        if px_si[15] = 13 then do
          call lex_drop m
          call advance
          sc = find_class(sup)
          if sc = 0 & sup \== "nil" then do
            call perr "unknown superclass " || sup
            return
          end
          cn = define_class(nme, sc)
          call parse_class_body cn
          return
        end
      end
    end
    else if px_si[15] = 1 & px_ss[7] == "extend" then do
      call advance
      if px_si[15] = 13 then do
        call lex_drop m
        call advance
        cn = find_class(nme)
        if cn = 0 then do
          call perr "unknown class " || nme
          return
        end
        call parse_class_body cn
        return
      end
    end
    else if px_si[15] = 1 & px_ss[7] == "class" then do
      call advance
      if px_si[15] = 1 & px_ss[7] == "extend" then do
        call advance
        if px_si[15] = 13 then do
          call lex_drop m
          call advance
          cn = find_class(nme)
          if cn = 0 then do
            call perr "unknown class " || nme
            return
          end
          call parse_class_body px_cls[cn*8+2]
          return
        end
      end
      else if isbin(">>") = 1 then do
        call advance
        if pattern_follows() = 1 then do
          call lex_drop m
          cn = find_class(nme)
          if cn = 0 then do
            call perr "unknown class " || nme
            return
          end
          call parse_method_def px_cls[cn*8+2]
          return
        end
      end
      else if px_si[15] = 13 then do
        call lex_drop m
        call advance
        cn = find_class(nme)
        if cn = 0 then do
          call perr "unknown class " || nme
          return
        end
        call parse_class_body px_cls[cn*8+2]
        return
      end
    end
    else if isbin(">>") = 1 then do
      call advance
      if pattern_follows() = 1 then do
        call lex_drop m
        cn = find_class(nme)
        if cn = 0 then do
          call perr "unknown class " || nme
          return
        end
        call parse_method_def cn
        return
      end
    end
    call lex_reset m
  end
  if isbin("|") = 1 | isbin("||") = 1 then do
    n = parse_temps()
    return
  end
  st = parse_statement()
  if px_si[14] = 0 then call run_doit st
  return

/* ---------------------------------------------------------------------
   File-in: parse and execute a whole source text
   --------------------------------------------------------------------- */
file_in: procedure = .void
  arg text = .string, name = .string
  sv_txt = .string
  sv_tp = .int
  sv_len = .int
  sv_name = .string
  sv_tk = .int
  sv_ts = .string
  sv_ti = .int
  sv_tf = .float
  sv_tpos = .int
  sv_pkh = .int
  sv_pkt = .int
  sv_pks = .string
  sv_pki = .int
  sv_pkf = .float
  sv_pkp = .int
  sv_pe = .int
  sv_txt = px_ss[5]
  sv_tp = px_si[12]
  sv_len = px_si[13]
  sv_name = px_ss[6]
  sv_tk = px_si[15]
  sv_ts = px_ss[7]
  sv_ti = px_si[16]
  sv_tf = px_sf[1]
  sv_tpos = px_si[17]
  sv_pkh = px_si[21]
  sv_pkt = px_si[22]
  sv_pks = px_ss[9]
  sv_pki = px_si[23]
  sv_pkf = px_sf[3]
  sv_pkp = px_si[24]
  sv_pe = px_si[14]
  px_ss[5] = text
  px_si[12] = 1
  px_si[13] = length(text)
  px_ss[6] = name
  px_si[21] = 0
  px_si[14] = 0
  call advance
  do while px_si[15] \= 0 & px_si[2] = 0
    px_si[14] = 0
    if px_si[15] = 17 | px_si[15] = 20 then do
      call advance
      iterate
    end
    call top_item
    if px_si[14] = 1 then do
      /* resynchronise at the next statement end */
      do while px_si[15] \= 0 & px_si[15] \= 17 & px_si[15] \= 20
        call advance
      end
    end
    else if px_si[15] = 17 | px_si[15] = 20 then call advance
  end
  px_ss[5] = sv_txt
  px_si[12] = sv_tp
  px_si[13] = sv_len
  px_ss[6] = sv_name
  px_si[15] = sv_tk
  px_ss[7] = sv_ts
  px_si[16] = sv_ti
  px_sf[1] = sv_tf
  px_si[17] = sv_tpos
  px_si[21] = sv_pkh
  px_si[22] = sv_pkt
  px_ss[9] = sv_pks
  px_si[23] = sv_pki
  px_sf[3] = sv_pkf
  px_si[24] = sv_pkp
  px_si[14] = sv_pe
  return

read_file: procedure = .string
  arg fn = .string
  fid = .int
  eof = .int
  rcx = .int
  line = .string
  acc = .string
  chunk = .string
  nl = .int
  rmode = "r"
  fid = 0
  assembler fopen fid, fn, rmode
  if fid = 0 then return ""
  acc = ""
  chunk = ""
  nl = 0
  eof = 0
  do while eof = 0
    line = ""
    assembler freadline line, fid
    assembler feof eof, fid
    if eof > 0 & length(line) = 0 then leave
    chunk = chunk || line || '0a'x
    nl = nl + 1
    if nl >= 100 then do
      acc = acc || chunk
      chunk = ""
      nl = 0
    end
  end
  assembler fclose rcx, fid
  return acc || chunk

/* ---------------------------------------------------------------------
   Interactive prompt: read statements from standard input one at a time
   and print the value of each expression
   --------------------------------------------------------------------- */
bracket_depth: procedure = .int
  arg t = .string
  d = .int
  i = .int
  n = .int
  ch = .string
  inq = .int
  inc = .int
  d = 0
  inq = 0
  inc = 0
  n = length(t)
  i = 1
  do while i <= n
    ch = substr(t, i, 1)
    if inq = 1 then do
      if ch == "'" then inq = 0
    end
    else if inc = 1 then do
      if ch == '"' then inc = 0
    end
    else do
      if ch == "'" then inq = 1
      else if ch == '"' then inc = 1
      else if ch == "$" then i = i + 1
      else if ch == "[" | ch == "(" | ch == "{" then d = d + 1
      else if ch == "]" | ch == ")" | ch == "}" then d = d - 1
    end
    i = i + 1
  end
  if inq = 1 | inc = 1 then d = d + 1
  return d

repl_loop: procedure = .void
  buf = .string
  line = .string
  ul = .int
  cmd = .string
  buf = ""
  call outs "CREXX Smalltalk - type exit to leave" || '0a'x
  do forever
    if px_si[2] = 1 then leave
    if buf == "" then call outs "st> "
    else call outs "... "
    call flush_out
    ul = read_stdin_line()
    if ul = 0 then leave
    line = o_s[ul % 2]
    cmd = strip(line)
    if buf == "" & (cmd == "exit" | cmd == "quit" | cmd == "bye") then leave
    buf = buf || line || '0a'x
    if bracket_depth(buf) <= 0 then do
      px_si[9] = 1
      call file_in buf, "stdin"
      px_si[9] = 0
      buf = ""
    end
  end
  call outs '0a'x
  return


/* ---------------------------------------------------------------------
   Resolver: turns the raw syntax tree into executable nodes in place
   --------------------------------------------------------------------- */
declare_var: procedure = .int
  arg nme = .string
  s = .int
  s = px_env[(px_si[33])*5+3]
  px_env[(px_si[33])*5+3] = s + 1
  if s + 1 > px_env[(px_si[33])*5+4] then px_env[(px_si[33])*5+4] = s + 1
  px_si[32] = px_si[32] + 1
  px_str[(px_si[32])*8+4] = nme
  px_env[(px_si[32])*5+1] = s
  px_env[(px_si[32])*5+2] = px_si[33]
  return s

/* sets rv_kind (1 local, 2 ivar, 3 global cell), rv_a, rv_b */
lookup_var: procedure = .void
  arg nme = .string
  k = .int
  w = .int
  do k = px_si[32] to 1 by -1
    if px_str[k*8+4] == nme then do
      px_si[39] = 1
      px_si[40] = px_si[33] - px_env[k*5+2]
      px_si[41] = px_env[k*5+1]
      return
    end
  end
  w = wordpos(nme, px_str[(px_si[34])*8+6])
  if w > 0 then do
    px_si[39] = 2
    px_si[40] = w - 1
    return
  end
  k = find_cvar(px_si[34], nme)
  if k > 0 then do
    px_si[39] = 3
    px_si[40] = k
    return
  end
  px_si[39] = 3
  px_si[40] = gcell(nme)
  return

rs_list: procedure = .void
  arg first = .int, n = .int
  i = .int
  do i = first to first + n - 1
    al[i] = rs(al[i])
  end
  return

rs_seq: procedure = .void
  arg n = .int
  call rs_list px_node[n*6+2], px_node[n*6+3]
  return

/* an inlined block: declare its parameters and temporaries, resolve the body */
inline_block: procedure = .int
  arg b = .int
  first = .int
  sv = .int
  i = .int
  body = .int
  sv = px_si[32]
  first = -1
  do i = 0 to px_node[b*6+4] - 1
    px_si[38] = declare_var(px_str[(px_node[b*6+3] + i)*8+3])
    if first < 0 then first = px_si[38]
  end
  do i = 0 to px_node[b*6+6] - 1
    px_si[38] = declare_var(px_str[(px_node[b*6+5] + i)*8+3])
  end
  body = px_node[b*6+2]
  call rs_seq body
  px_si[32] = sv
  px_si[37] = first
  return body

is_blk: procedure = .int
  arg n = .int, np = .int
  if px_node[n*6+1] = 44 & px_node[n*6+4] = np then return 1
  return 0

is_blk01: procedure = .int
  arg n = .int
  if px_node[n*6+1] = 44 & px_node[n*6+4] <= 1 then return 1
  return 0

rs: procedure = .int
  arg n = .int
  t = .int
  nme = .string
  k = .int
  s = .string
  a1 = .int
  a2 = .int
  a3 = .int
  a4 = .int
  i = .int
  f = .int
  sv = .int
  r = .int
  ok = .int
  t = px_node[n*6+1]
  select
    when t = 1 | t = 2 | t = 16 then nop
    when t = 40 then do
      nme = n_s[n]
      if nme == "self" | nme == "super" then px_node[n*6+1] = 2
      else do
        call lookup_var nme
        if px_si[39] = 1 then do
          px_node[n*6+1] = 3
          px_node[n*6+2] = px_si[40]
          px_node[n*6+3] = px_si[41]
        end
        else if px_si[39] = 2 then do
          px_node[n*6+1] = 4
          px_node[n*6+2] = px_si[40]
        end
        else do
          px_node[n*6+1] = 5
          px_node[n*6+2] = px_si[40]
        end
      end
    end
    when t = 41 then do
      px_node[n*6+4] = rs(px_node[n*6+2])
      call lookup_var n_s[n]
      if px_si[39] = 1 then do
        px_node[n*6+1] = 6
        px_node[n*6+2] = px_si[40]
        px_node[n*6+3] = px_si[41]
      end
      else if px_si[39] = 2 then do
        px_node[n*6+1] = 7
        px_node[n*6+2] = px_si[40]
      end
      else do
        px_node[n*6+1] = 8
        px_node[n*6+2] = px_si[40]
      end
    end
    when t = 45 then do
      px_node[n*6+2] = rs(px_node[n*6+2])
      px_node[n*6+1] = 13
      if px_si[33] > 1 then px_node[n*6+6] = 1
      else px_node[n*6+6] = 0
    end
    when t = 14 then call rs_seq n
    when t = 15 then call rs_list px_node[n*6+2], px_node[n*6+3]
    when t = 44 then do
      /* a real block: its own scope level */
      sv = px_si[32]
      px_env[(px_si[33])*5+5] = 1
      px_si[33] = px_si[33] + 1
      px_env[(px_si[33])*5+3] = 0
      px_env[(px_si[33])*5+4] = 0
      px_env[(px_si[33])*5+5] = 0
      do i = 0 to px_node[n*6+4] - 1
        k = declare_var(px_str[(px_node[n*6+3] + i)*8+3])
      end
      do i = 0 to px_node[n*6+6] - 1
        k = declare_var(px_str[(px_node[n*6+5] + i)*8+3])
      end
      call rs_seq px_node[n*6+2]
      px_node[n*6+1] = 12
      px_node[n*6+3] = px_node[n*6+4]
      px_node[n*6+4] = px_env[(px_si[33])*5+4]
      px_node[n*6+5] = px_env[(px_si[33])*5+5]
      px_si[33] = px_si[33] - 1
      px_si[32] = sv
    end
    when t = 43 then do
      px_node[n*6+2] = rs(px_node[n*6+2])
      f = px_node[n*6+3]
      do i = f to f + px_node[n*6+4] - 1
        k = al[i]
        call rs_list px_node[k*6+3], px_node[k*6+6]
        px_node[k*6+4] = selid(n_s[k])
        px_node[k*6+1] = 11
      end
      px_node[n*6+1] = 10
    end
    when t = 42 then do
      s = n_s[n]
      r = inline_send(n, s)
      if r = 0 then do
        px_node[n*6+2] = rs(px_node[n*6+2])
        call rs_list px_node[n*6+3], px_node[n*6+6]
        px_node[n*6+4] = selid(s)
        px_node[n*6+1] = 9
      end
    end
    otherwise nop
  end
  return n

/* try to compile a control-flow message inline; returns 1 if done */
inline_send: procedure = .int
  arg n = .int, s = .string
  rcv = .int
  f = .int
  na = .int
  a1 = .int
  a2 = .int
  a3 = .int
  c = .int
  b1 = .int
  b2 = .int
  st = .int
  sl1 = .int
  fv = .int
  a1 = 0
  a2 = 0
  a3 = 0
  rcv = px_node[n*6+2]
  f = px_node[n*6+3]
  na = px_node[n*6+6]
  if na >= 1 then a1 = al[f]
  if na >= 2 then a2 = al[f + 1]
  if na >= 3 then a3 = al[f + 2]
  if s == "ifTrue:" & is_blk(a1, 0) = 1 then do
    px_node[n*6+2] = rs(rcv)
    px_node[n*6+3] = inline_block(a1)
    px_node[n*6+4] = 0
    px_node[n*6+1] = 20
    return 1
  end
  if s == "ifFalse:" & is_blk(a1, 0) = 1 then do
    px_node[n*6+2] = rs(rcv)
    px_node[n*6+4] = inline_block(a1)
    px_node[n*6+3] = 0
    px_node[n*6+1] = 20
    return 1
  end
  if s == "ifTrue:ifFalse:" & is_blk(a1, 0) = 1 & is_blk(a2, 0) = 1 then do
    px_node[n*6+2] = rs(rcv)
    px_node[n*6+3] = inline_block(a1)
    px_node[n*6+4] = inline_block(a2)
    px_node[n*6+1] = 20
    return 1
  end
  if s == "ifFalse:ifTrue:" & is_blk(a1, 0) = 1 & is_blk(a2, 0) = 1 then do
    px_node[n*6+2] = rs(rcv)
    px_node[n*6+4] = inline_block(a1)
    px_node[n*6+3] = inline_block(a2)
    px_node[n*6+1] = 20
    return 1
  end
  if (s == "and:" | s == "or:") & is_blk(a1, 0) = 1 then do
    px_node[n*6+2] = rs(rcv)
    px_node[n*6+3] = inline_block(a1)
    if s == "and:" then px_node[n*6+1] = 24
    else px_node[n*6+1] = 25
    return 1
  end
  if (s == "whileTrue:" | s == "whileFalse:") & is_blk(rcv, 0) = 1 & is_blk(a1, 0) = 1 then do
    px_node[n*6+2] = inline_block(rcv)
    px_node[n*6+3] = inline_block(a1)
    if s == "whileTrue:" then px_node[n*6+6] = 1
    else px_node[n*6+6] = 0
    px_node[n*6+1] = 21
    return 1
  end
  if (s == "whileTrue" | s == "whileFalse") & is_blk(rcv, 0) = 1 then do
    px_node[n*6+2] = inline_block(rcv)
    px_node[n*6+3] = 0
    if s == "whileTrue" then px_node[n*6+6] = 1
    else px_node[n*6+6] = 0
    px_node[n*6+1] = 21
    return 1
  end
  if s == "repeat" & is_blk(rcv, 0) = 1 then do
    px_node[n*6+2] = inline_block(rcv)
    px_node[n*6+1] = 27
    return 1
  end
  if s == "timesRepeat:" & is_blk(a1, 0) = 1 then do
    px_node[n*6+2] = rs(rcv)
    px_node[n*6+3] = inline_block(a1)
    px_node[n*6+1] = 23
    return 1
  end
  if s == "to:do:" & is_blk(a2, 1) = 1 then do
    px_node[n*6+2] = rs(rcv)
    px_node[n*6+3] = rs(a1)
    px_node[n*6+4] = inline_block(a2)
    px_node[n*6+6] = px_si[37]
    px_node[n*6+5] = 0
    px_node[n*6+1] = 22
    return 1
  end
  if s == "to:by:do:" & is_blk(a3, 1) = 1 then do
    px_node[n*6+2] = rs(rcv)
    px_node[n*6+3] = rs(a1)
    st = rs(a2)
    px_node[n*6+4] = inline_block(a3)
    px_node[n*6+6] = px_si[37]
    px_node[n*6+5] = st
    px_node[n*6+1] = 22
    return 1
  end
  if s == "ifNil:" & is_blk(a1, 0) = 1 then do
    px_node[n*6+2] = rs(rcv)
    px_node[n*6+3] = inline_block(a1)
    px_node[n*6+4] = 0
    px_node[n*6+5] = 1
    px_node[n*6+6] = -1
    px_node[n*6+1] = 26
    return 1
  end
  if s == "ifNotNil:" & is_blk01(a1) = 1 then do
    px_node[n*6+2] = rs(rcv)
    px_node[n*6+3] = 0
    px_node[n*6+4] = inline_block(a1)
    px_node[n*6+6] = -1
    if px_node[a1*6+4] = 1 then px_node[n*6+6] = px_si[37]
    px_node[n*6+5] = 0
    px_node[n*6+1] = 26
    return 1
  end
  if s == "ifNil:ifNotNil:" & is_blk(a1, 0) = 1 & is_blk01(a2) = 1 then do
    px_node[n*6+2] = rs(rcv)
    px_node[n*6+3] = inline_block(a1)
    sl1 = 0
    c = inline_block(a2)
    px_node[n*6+4] = c
    px_node[n*6+6] = -1
    if px_node[a2*6+4] = 1 then px_node[n*6+6] = px_si[37]
    px_node[n*6+5] = 0
    px_node[n*6+1] = 26
    return 1
  end
  if s == "ifNotNil:ifNil:" & is_blk01(a1) = 1 & is_blk(a2, 0) = 1 then do
    px_node[n*6+2] = rs(rcv)
    c = inline_block(a1)
    px_node[n*6+4] = c
    px_node[n*6+6] = -1
    if px_node[a1*6+4] = 1 then px_node[n*6+6] = px_si[37]
    px_node[n*6+3] = inline_block(a2)
    px_node[n*6+5] = 0
    px_node[n*6+1] = 26
    return 1
  end
  return 0

/* ---------------------------------------------------------------------
   Entry points
   --------------------------------------------------------------------- */
start_scope: procedure = .void
  arg c = .int
  px_si[34] = c
  px_si[32] = 0
  px_si[33] = 1
  px_env[1*5+3] = 0
  px_env[1*5+4] = 0
  px_env[1*5+5] = 0
  return

compile_method: procedure = .void
  arg c = .int, sel = .string, pfirst = .int, np = .int, tfirst = .int, ntemps = .int, body = .int, prim = .int, startp = .int
  i = .int
  k = .int
  m = .int
  call start_scope c
  do i = 0 to np - 1
    k = declare_var(px_str[(pfirst + i)*8+3])
  end
  do i = 0 to ntemps - 1
    k = declare_var(px_str[(tfirst + i)*8+3])
  end
  call rs_seq body
  m = install_method(c, selid(sel), np, body, px_env[1*5+4], px_env[1*5+5], prim)
  px_meth[m*8+8] = startp
  return

/* run a top-level statement (a raw node) */
run_doit: procedure = .void
  arg st = .int
  seq = .int
  first = .int
  fb = .int
  v = .int
  eb = .int
  er = .int
  call start_scope px_si[57]
  px_si[31] = px_si[31] + 1
  al[px_si[31]] = st
  seq = nd(14, px_si[31], 1, 0, 0, 0, "")
  call rs_seq seq
  fb = alloc_frame(4 + px_env[1*5+4])
  vp[fb + 0] = 0
  vp[fb + 1] = fb
  vp[fb + 2] = 2
  vp[fb + 3] = 0
  call init_temps fb + 4, px_env[1*5+4]
  px_si[65] = 0
  px_si[67] = 0
  px_si[70] = 0
  v = ev(seq, fb)
  if px_si[9] = 1 & px_si[67] = 0 & v \= 2 then do
    if cof(v) \= find_class("TextCollector") then do
      eb = px_si[64]
      er = send_sel(v, 22, eb, 0)
      px_si[64] = eb
      if px_si[67] = 0 & isstr(er) = 1 then call outs o_s[er % 2] || '0a'x
      else call outs printstr0(v) || '0a'x
      px_si[67] = 0
    end
  end
  if px_si[67] > 0 then do
    if px_si[67] = 6 then px_si[2] = 1
    px_si[67] = 0
  end
  px_si[70] = 0
  return

/* evaluate an expression node in the context of a class (class variable initialisers) */
eval_in_class: procedure = .int
  arg c = .int, e = .int
  seq = .int
  fb = .int
  v = .int
  call start_scope c
  px_si[31] = px_si[31] + 1
  al[px_si[31]] = e
  seq = nd(14, px_si[31], 1, 0, 0, 0, "")
  call rs_seq seq
  fb = alloc_frame(4 + px_env[1*5+4])
  vp[fb + 0] = 0
  vp[fb + 1] = fb
  vp[fb + 2] = 2
  vp[fb + 3] = 0
  call init_temps fb + 4, px_env[1*5+4]
  v = ev(seq, fb)
  if px_si[67] > 0 then px_si[67] = 0
  return v


/* ---------------------------------------------------------------------
   Objects.  An oop is 2*index for heap objects, 2*n+1 for SmallIntegers.
   --------------------------------------------------------------------- */
mkint: procedure = .int
  arg n = .int
  return n * 2 + 1

intval: procedure = .int
  arg x = .int
  return (x - 1) % 2

newobj: procedure = .int
  arg cls = .int, kind = .int, n = .int
  i = .int
  px_si[42] = px_si[42] + 1
  px_obj[(px_si[42])*5+1] = cls
  px_obj[(px_si[42])*5+2] = kind
  px_obj[(px_si[42])*5+3] = n
  px_obj[(px_si[42])*5+5] = 0
  o_s[px_si[42]] = ""
  o_f[px_si[42]] = 0.0
  px_obj[(px_si[42])*5+4] = px_si[43] + 1
  do i = 1 to n
    px_si[43] = px_si[43] + 1
    sl[px_si[43]] = 2
  end
  return px_si[42] * 2

slot_get: procedure = .int
  arg o = .int, i = .int
  return sl[px_obj[(o % 2)*5+4] + i]

slot_put: procedure = .void
  arg o = .int, i = .int, v = .int
  sl[px_obj[(o % 2)*5+4] + i] = v
  return

mkstr: procedure = .int
  arg s = .string
  o = .int
  o = newobj(px_si[48], 1, 0)
  o_s[o % 2] = s
  return o

mksym: procedure = .int
  arg s = .string
  o = .int
  v = .string
  v = symtab[s]
  if v \== "" then return v as .int
  o = newobj(px_si[49], 2, 0)
  o_s[o % 2] = s
  symtab[s] = o
  return o

mkfloat: procedure = .int
  arg f = .float
  o = .int
  o = newobj(px_si[50], 3, 0)
  o_f[o % 2] = f
  return o

mkchar: procedure = .int
  arg code = .int
  o = .int
  if code < 0 | code > 255 then code = 63
  if chr_oop[code + 1] = 0 then do
    o = newobj(px_si[51], 5, 0)
    px_obj[(o % 2)*5+5] = code
    chr_oop[code + 1] = o
  end
  return chr_oop[code + 1]

mkarray: procedure = .int
  arg n = .int
  return newobj(px_si[52], 4, n)

mkbool: procedure = .int
  arg b = .int
  if b = 1 then return 4
  return 6

/* class number of any oop */
cof: procedure = .int
  arg x = .int
  if x // 2 \= 0 then return px_si[53]
  return px_obj[(x % 2)*5+1]

kindof: procedure = .int
  arg x = .int
  if x // 2 \= 0 then return -1
  return px_obj[(x % 2)*5+2]

/* string contents of a String or Symbol (or "" for anything else) */
strof: procedure = .string
  arg x = .int
  k = .int
  if x // 2 \= 0 then return ""
  k = px_obj[(x % 2)*5+2]
  if k = 1 | k = 2 | k = 7 then return o_s[x % 2]
  return ""

isstr: procedure = .int
  arg x = .int
  if x // 2 \= 0 then return 0
  if px_obj[(x % 2)*5+2] = 1 | px_obj[(x % 2)*5+2] = 2 then return 1
  return 0

/* ---------------------------------------------------------------------
   Globals, selectors
   --------------------------------------------------------------------- */
gcell: procedure = .int
  arg nme = .string
  v = .string
  v = gmap[nme]
  if v \== "" then return v as .int
  px_si[61] = px_si[61] + 1
  g_val[px_si[61]] = 2
  px_str[(px_si[61])*8+7] = nme
  gmap[nme] = px_si[61]
  return px_si[61]

gset: procedure = .void
  arg nme = .string, v = .int
  g_val[gcell(nme)] = v
  return

selid: procedure = .int
  arg nme = .string
  v = .string
  n = .int
  p = .int
  v = selmap[nme]
  if v \== "" then return v as .int
  px_si[62] = px_si[62] + 1
  if px_si[62] >= 2048 then do
    call outs "too many selectors" || '0a'x
    return 1
  end
  px_str[(px_si[62])*8+8] = nme
  n = 0
  if isletter(left(nme, 1)) = 1 then n = length(nme) - length(translate(nme, "", ":"))
  else n = 1
  sel_n[px_si[62]] = n
  selmap[nme] = px_si[62]
  return px_si[62]

/* ---------------------------------------------------------------------
   Classes
   --------------------------------------------------------------------- */
find_class: procedure = .int
  arg nme = .string
  v = .string
  v = cmap[nme]
  if v == "" then return 0
  return v as .int

mkclassrec: procedure = .int
  arg nme = .string, sup = .int
  c = .int
  px_si[44] = px_si[44] + 1
  c = px_si[44]
  px_str[c*8+5] = nme
  px_cls[c*8+1] = sup
  px_cls[c*8+2] = 0
  px_cls[c*8+3] = 0
  px_cls[c*8+4] = 0
  px_cls[c*8+5] = 0
  px_cls[c*8+6] = 0
  px_str[c*8+6] = ""
  px_cls[c*8+8] = 0
  px_cls[c*8+7] = 0
  if px_si[3] = 0 then px_cls[c*8+7] = 1
  if sup > 0 then do
    px_cls[c*8+5] = px_cls[sup*8+5]
    px_cls[c*8+6] = px_cls[sup*8+6]
    px_str[c*8+6] = px_str[sup*8+6]
  end
  return c

/* create (or reopen) class nme with superclass sup (0 = none) */
define_class: procedure = .int
  arg nme = .string, sup = .int
  c = .int
  m = .int
  msup = .int
  o = .int
  c = find_class(nme)
  if c > 0 then do
    if px_si[3] = 1 & px_cls[c*8+7] = 1 then do
      /* the program redefines a library class: start from a clean slate */
      px_cls[c*8+7] = 0
      m = px_cls[c*8+2]
      do i = 1 to px_si[62]
        cm[c * 2048 + i] = 0
        cm[m * 2048 + i] = 0
      end
      if sup > 0 then do
        px_str[c*8+6] = px_str[sup*8+6]
        px_cls[c*8+6] = px_cls[sup*8+6]
      end
      else do
        px_str[c*8+6] = ""
        px_cls[c*8+6] = 0
      end
      px_si[60] = px_si[60] + 1
    end
    if px_cls[c*8+1] \= sup then do
      px_cls[c*8+1] = sup
      if sup > 0 then do
        px_str[c*8+6] = px_str[sup*8+6]
        px_cls[c*8+6] = px_cls[sup*8+6]
        px_cls[c*8+5] = px_cls[sup*8+5]
        px_cls[(px_cls[c*8+2])*8+1] = px_cls[sup*8+2]
      end
      px_si[60] = px_si[60] + 1
    end
    return c
  end
  c = mkclassrec(nme, sup)
  if sup > 0 then msup = px_cls[sup*8+2]
  else msup = px_si[46]
  m = mkclassrec(nme || " class", msup)
  px_cls[m*8+3] = 1
  px_cls[m*8+4] = c
  px_cls[c*8+2] = m
  if sup > 0 then do
    px_cls[m*8+6] = px_cls[msup*8+6]
    px_str[m*8+6] = px_str[msup*8+6]
  end
  else do
    px_cls[m*8+6] = 0
    px_str[m*8+6] = ""
  end
  px_cls[m*8+5] = 0
  o = newobj(m, 9, px_cls[m*8+6])
  px_obj[(o % 2)*5+5] = c
  px_cls[c*8+8] = o
  o = newobj(px_si[47], 10, 0)
  px_obj[(o % 2)*5+5] = m
  px_cls[m*8+8] = o
  cmap[nme] = c
  call gset nme, px_cls[c*8+8]
  if nme == "Class" then px_si[46] = c
  return c

add_ivar: procedure = .void
  arg c = .int, nme = .string
  k = .int
  oldn = .int
  if wordpos(nme, px_str[c*8+6]) > 0 then return
  oldn = words(px_str[c*8+6])
  px_str[c*8+6] = strip(px_str[c*8+6] || " " || nme)
  px_cls[c*8+6] = oldn + 1
  do k = 1 to px_si[44]
    if px_cls[k*8+1] = c then call ivar_inherit k, oldn, c
  end
  /* class-side variables: grow the slots of the class objects */
  do k = 1 to px_si[44]
    if px_cls[k*8+3] = 1 & px_cls[(px_cls[k*8+4])*8+8] > 0 then do
      if inherits(k, c) = 1 then call grow_class_slots px_cls[k*8+4]
    end
  end
  return

ivar_inherit: procedure = .void
  arg k = .int, oldn = .int, parent = .int
  own = .string
  kold = .int
  j = .int
  kold = words(px_str[k*8+6])
  own = ""
  if kold > oldn then own = subword(px_str[k*8+6], oldn + 1)
  px_str[k*8+6] = strip(px_str[parent*8+6] || " " || own)
  px_cls[k*8+6] = words(px_str[k*8+6])
  do j = 1 to px_si[44]
    if px_cls[j*8+1] = k then call ivar_inherit j, kold, k
  end
  return

grow_class_slots: procedure = .void
  arg c = .int
  o = .int
  need = .int
  have = .int
  i = .int
  old = .int
  base = .int
  o = px_cls[c*8+8] % 2
  need = px_cls[(px_cls[c*8+2])*8+6]
  have = px_obj[o*5+3]
  if need <= have then return
  old = px_obj[o*5+4]
  base = px_si[43] + 1
  do i = 0 to have - 1
    px_si[43] = px_si[43] + 1
    sl[px_si[43]] = sl[old + i]
  end
  do i = have + 1 to need
    px_si[43] = px_si[43] + 1
    sl[px_si[43]] = 2
  end
  px_obj[o*5+4] = base
  px_obj[o*5+3] = need
  return

/* ---------------------------------------------------------------------
   Methods
   --------------------------------------------------------------------- */
install_method: procedure = .int
  arg c = .int, sel = .int, nargs = .int, body = .int, ntemps = .int, hasblk = .int, prim = .int
  m = .int
  px_si[59] = px_si[59] + 1
  m = px_si[59]
  px_meth[m*8+1] = sel
  px_meth[m*8+2] = c
  px_meth[m*8+3] = nargs
  px_meth[m*8+4] = body
  px_meth[m*8+5] = ntemps
  px_meth[m*8+6] = hasblk
  px_meth[m*8+7] = prim
  cm[c * 2048 + sel] = m
  px_si[60] = px_si[60] + 1
  return m

lookup: procedure = .int
  arg c = .int, sel = .int
  i = .int
  k = .int
  m = .int
  i = c * 2048 + sel
  if lkg[i] = px_si[60] then return lk[i]
  m = 0
  k = c
  do while k > 0
    m = cm[k * 2048 + sel]
    if m > 0 then leave
    k = px_cls[k*8+1]
  end
  lk[i] = m
  lkg[i] = px_si[60]
  return m

/* is class c a subclass of (or equal to) d ? */
inherits: procedure = .int
  arg c = .int, d = .int
  k = .int
  k = c
  do while k > 0
    if k = d then return 1
    k = px_cls[k*8+1]
  end
  return 0

/* class variables: name -> cell (searching up the superclass chain) */
find_cvar: procedure = .int
  arg c0 = .int, nme = .string
  c = .int
  v = .string
  c = c0
  if px_cls[c*8+3] = 1 then c = px_cls[c*8+4]
  do while c > 0
    v = cvmap[c || "." || nme]
    if v \== "" then return v as .int
    c = px_cls[c*8+1]
  end
  return 0

define_classvar: procedure = .void
  arg c0 = .int, nme = .string, e = .int
  c = .int
  cell = .int
  v = .int
  c = c0
  if px_cls[c*8+3] = 1 then c = px_cls[c*8+4]
  cell = find_cvar(c, nme)
  if cell = 0 | cvmap[c || "." || nme] == "" then do
    px_si[61] = px_si[61] + 1
    g_val[px_si[61]] = 2
    px_str[(px_si[61])*8+7] = nme
    cvmap[c || "." || nme] = px_si[61]
    cell = px_si[61]
  end
  v = eval_in_class(c, e)
  g_val[cell] = v
  return


/* ---------------------------------------------------------------------
   Frames
   --------------------------------------------------------------------- */
alloc_frame: procedure = .int
  arg size = .int
  fb = .int
  fb = fl_head[size]
  if fb > 0 then do
    fl_head[size] = vp[fb]
    return fb
  end
  fb = px_si[63] + 1
  px_si[63] = px_si[63] + size
  return fb

free_frame: procedure = .void
  arg fb = .int, size = .int
  vp[fb] = fl_head[size]
  fl_head[size] = fb
  return

init_temps: procedure = .void
  arg base = .int, n = .int
  i = .int
  do i = 0 to n - 1
    vp[base + i] = 2
  end
  return

/* ---------------------------------------------------------------------
   Sending messages
   --------------------------------------------------------------------- */
trace_line: procedure = .string
  arg m = .int, r = .int
  rc = .int
  rc = cof(r)
  if rc = px_meth[m*8+2] then return px_str[rc*8+5] || ">>" || px_str[(px_meth[m*8+1])*8+8]
  return px_str[rc*8+5] || "(" || px_str[(px_meth[m*8+2])*8+5] || ")>>" || px_str[(px_meth[m*8+1])*8+8]

print_trace: procedure = .void
  i = .int
  sg0 = .int
  mc = .int
  sg0 = find_class("Signal")
  do i = px_si[65] to 1 by -1
    mc = px_meth[(px_h[i*5+1])*8+2]
    if px_cls[mc*8+3] = 1 then mc = px_cls[mc*8+4]
    if sg0 = 0 | inherits(mc, sg0) = 0 then call outs trace_line(px_h[i*5+1], px_h[i*5+2]) || '0a'x
  end
  call outs "UndefinedObject>>executeStatements" || '0a'x
  return

/* report an error as a Smalltalk Error (signal) with the given text */
st_error: procedure = .void
  arg rcv = .int, msg = .string
  base = .int
  r = .int
  base = px_si[64]
  px_si[64] = px_si[64] + 1
  ast[px_si[64]] = mkstr(msg)
  r = send_sel(rcv, 50, base, 1)
  px_si[64] = base
  return

/* perform a send whose arguments are already at ast[base+1 .. base+na] */
send_sel: procedure = .int
  arg rcv = .int, sel = .int, base = .int, na = .int
  m = .int
  c = .int
  c = cof(rcv)
  m = lookup(c, sel)
  if m = 0 then return send_dnu(rcv, sel, base, na)
  return invoke(m, rcv, base, na)

send_dnu: procedure = .int
  arg rcv = .int, sel = .int, base = .int, na = .int
  msg = .int
  arr = .int
  i = .int
  m = .int
  b2 = .int
  if px_si[66] > 50 then do
    call outs "doesNotUnderstand: recursion for #" || px_str[sel*8+8] || '0a'x
    px_si[67] = 5
    return 0
  end
  arr = mkarray(na)
  do i = 1 to na
    call slot_put arr, i - 1, ast[base + i]
  end
  msg = newobj(px_si[58], 0, 2)
  call slot_put msg, 0, mksym(px_str[sel*8+8])
  call slot_put msg, 1, arr
  m = lookup(cof(rcv), 21)
  if m = 0 then do
    call outs "Object: " || printstr0(rcv) || " error: did not understand #" || px_str[sel*8+8] || '0a'x
    px_si[67] = 5
    return 0
  end
  b2 = px_si[64]
  px_si[64] = px_si[64] + 1
  ast[px_si[64]] = msg
  px_si[66] = px_si[66] + 1
  i = invoke(m, rcv, b2, 1)
  px_si[66] = px_si[66] - 1
  px_si[64] = b2
  return i

printstr0: procedure = .string
  arg x = .int
  k = .int
  if x // 2 \= 0 then return intval(x) as .string
  k = px_obj[(x % 2)*5+2]
  if k = 1 then return "'" || o_s[x % 2] || "'"
  if k = 2 then return "#" || o_s[x % 2]
  if x = 2 then return "nil"
  if x = 4 then return "true"
  if x = 6 then return "false"
  if k = 9 | k = 10 then return px_str[(px_obj[(x % 2)*5+5])*8+5]
  return "a " || px_str[(px_obj[(x % 2)*5+1])*8+5]

/* run method m for receiver rcv with args at ast[base+1..base+na] */
invoke: procedure = .int
  arg m = .int, rcv = .int, base = .int, na = .int
  p = .int
  r = .int
  nf = .int
  size = .int
  i = .int
  body = .int
  nt0 = .int
  p = px_meth[m*8+7]
  if p > 0 then do
    r = prim(p, rcv, base, na)
    if px_si[67] > 0 then return 0
    if r \= 0 then return r
    if px_node[(px_meth[m*8+4])*6+3] = 0 then do
      call st_error rcv, "primitive failed: " || px_str[(px_meth[m*8+1])*8+8]
      return 0
    end
  end
  nt0 = px_meth[m*8+5]
  size = 4 + nt0
  nf = fl_head[size]
  if nf > 0 then fl_head[size] = vp[nf]
  else do
    nf = px_si[63] + 1
    px_si[63] = px_si[63] + size
  end
  vp[nf] = 0
  vp[nf + 1] = nf
  vp[nf + 2] = rcv
  vp[nf + 3] = m
  do i = 1 to px_meth[m*8+3]
    vp[nf + 3 + i] = ast[base + i]
  end
  do i = px_meth[m*8+3] + 1 to nt0
    vp[nf + 3 + i] = 2
  end
  px_si[65] = px_si[65] + 1
  if px_si[65] > 20000 then do
    call outs "call stack too deep" || '0a'x
    px_si[65] = px_si[65] - 1
    px_si[67] = 5
    return 0
  end
  px_h[(px_si[65])*5+1] = m
  px_h[(px_si[65])*5+2] = rcv
  r = ev(px_meth[m*8+4], nf)
  px_si[65] = px_si[65] - 1
  if px_si[67] = 1 & px_si[68] = nf then do
    px_si[67] = 0
    r = px_si[69]
  end
  else if px_si[67] = 0 then r = rcv
  else r = 0
  if px_meth[m*8+6] = 0 then do
    vp[nf] = fl_head[size]
    fl_head[size] = nf
  end
  else vp[nf + 1] = 0
  return r

/* ---------------------------------------------------------------------
   Blocks
   --------------------------------------------------------------------- */
call_block: procedure = .int
  arg blk = .int, base = .int, na = .int
  node = .int
  outer = .int
  size = .int
  bf = .int
  i = .int
  r = .int
  node = px_obj[(blk % 2)*5+5]
  if px_node[node*6+3] \= na then do
    call st_error blk, "wrong argument count"
    return 0
  end
  outer = px_obj[(blk % 2)*5+4]
  size = 4 + px_node[node*6+4]
  bf = fl_head[size]
  if bf > 0 then fl_head[size] = vp[bf]
  else do
    bf = px_si[63] + 1
    px_si[63] = px_si[63] + size
  end
  vp[bf] = outer
  vp[bf + 1] = vp[outer + 1]
  vp[bf + 2] = vp[outer + 2]
  vp[bf + 3] = vp[outer + 3]
  do i = 1 to na
    vp[bf + 3 + i] = ast[base + i]
  end
  do i = na + 1 to px_node[node*6+4]
    vp[bf + 3 + i] = 2
  end
  r = ev(px_node[node*6+2], bf)
  if px_node[node*6+5] = 0 then do
    vp[bf] = fl_head[size]
    fl_head[size] = bf
  end
  if px_si[67] > 0 then return 0
  return r

/* value of a block with no arguments */
block0: procedure = .int
  arg blk = .int
  return call_block(blk, px_si[64], 0)

/* ---------------------------------------------------------------------
   The evaluator
   --------------------------------------------------------------------- */
ev: procedure = .int
  arg n = .int, fb = .int
  t = .int
  t = px_node[n*6+1]
  if t = 9 then return do_send(n, fb)
  if t = 1 then return px_node[n*6+2]
  if t = 2 then return vp[fb + 2]
  if t = 3 then do
    if px_node[n*6+2] = 0 then return vp[fb + 4 + px_node[n*6+3]]
  end
  if t = 4 then return sl[px_obj[(vp[fb + 2] % 2)*5+4] + px_node[n*6+2]]
  if t = 5 then return g_val[px_node[n*6+2]]
  return ev_slow(n, fb)

ev_slow: procedure = .int
  arg n = .int, fb = .int
  ev_n = .int
  ev_t = .int
  t = .int
  d = .int
  f = .int
  v = .int
  i = .int
  c = .int
  lim = .int
  t = px_node[n*6+1]
  select
    when t = 3 then do
      d = px_node[n*6+2]
      f = fb
      do while d > 0
        f = vp[f]
        d = d - 1
      end
      return vp[f + 4 + px_node[n*6+3]]
    end
    when t = 9 then return do_send(n, fb)
    when t = 1 then return px_node[n*6+2]
    when t = 2 then return vp[fb + 2]
    when t = 4 then return sl[px_obj[(vp[fb + 2] % 2)*5+4] + px_node[n*6+2]]
    when t = 5 then return g_val[px_node[n*6+2]]
    when t = 6 then do
      v = ev(px_node[n*6+4], fb)
      if px_si[67] > 0 then return 0
      d = px_node[n*6+2]
      f = fb
      do while d > 0
        f = vp[f]
        d = d - 1
      end
      vp[f + 4 + px_node[n*6+3]] = v
      return v
    end
    when t = 7 then do
      v = ev(px_node[n*6+4], fb)
      if px_si[67] > 0 then return 0
      sl[px_obj[(vp[fb + 2] % 2)*5+4] + px_node[n*6+2]] = v
      return v
    end
    when t = 8 then do
      v = ev(px_node[n*6+4], fb)
      if px_si[67] > 0 then return 0
      g_val[px_node[n*6+2]] = v
      return v
    end
    when t = 14 then do
      v = 2
      f = px_node[n*6+2]
      do i = f to f + px_node[n*6+3] - 1
        ev_n = al[i]
        ev_t = px_node[ev_n*6+1]
        if ev_t = 1 then v = px_node[ev_n*6+2]
        else if ev_t = 2 then v = vp[fb + 2]
        else if ev_t = 3 & px_node[ev_n*6+2] = 0 then v = vp[fb + 4 + px_node[ev_n*6+3]]
        else v = ev(ev_n, fb)
        if px_si[67] > 0 then return 0
      end
      return v
    end
    when t = 13 then do
      v = ev(px_node[n*6+2], fb)
      if px_si[67] > 0 then return 0
      f = vp[fb + 1]
      if px_node[n*6+6] = 1 & (f = 0 | vp[f + 1] \= f) then do
        call outs "BlockContext>>cannotReturn: non-local return from a dead method context" || '0a'x
        px_si[67] = 5
        return 0
      end
      px_si[67] = 1
      px_si[68] = f
      px_si[69] = v
      return 0
    end
    when t = 20 then do
      ev_n = px_node[n*6+2]
      ev_t = px_node[ev_n*6+1]
      if ev_t = 1 then v = px_node[ev_n*6+2]
      else if ev_t = 2 then v = vp[fb + 2]
      else if ev_t = 3 & px_node[ev_n*6+2] = 0 then v = vp[fb + 4 + px_node[ev_n*6+3]]
      else v = ev(ev_n, fb)
      if px_si[67] > 0 then return 0
      if v = 4 then do
        if px_node[n*6+3] > 0 then return ev(px_node[n*6+3], fb)
        return 2
      end
      if v = 6 then do
        if px_node[n*6+4] > 0 then return ev(px_node[n*6+4], fb)
        return 2
      end
      return not_boolean(v, "ifTrue:")
    end
    when t = 21 then do
      do forever
        v = ev(px_node[n*6+2], fb)
        if px_si[67] > 0 then return 0
        if v = 4 then c = 1
        else if v = 6 then c = 0
        else return not_boolean(v, "whileTrue:")
        if c \= px_node[n*6+6] then leave
        if px_node[n*6+3] > 0 then do
          v = ev(px_node[n*6+3], fb)
          if px_si[67] > 0 then return 0
        end
      end
      return 2
    end
    when t = 24 | t = 25 then do
      v = ev(px_node[n*6+2], fb)
      if px_si[67] > 0 then return 0
      if v = 4 then do
        if t = 24 then return ev(px_node[n*6+3], fb)
        return 4
      end
      if v = 6 then do
        if t = 25 then return ev(px_node[n*6+3], fb)
        return 6
      end
      return not_boolean(v, "and:")
    end
    when t = 22 then return do_todo(n, fb)
    when t = 23 then do
      v = ev(px_node[n*6+2], fb)
      if px_si[67] > 0 then return 0
      if v // 2 = 0 then return not_number(v, "timesRepeat:")
      lim = intval(v)
      do i = 1 to lim
        c = ev(px_node[n*6+3], fb)
        if px_si[67] > 0 then return 0
      end
      return v
    end
    when t = 26 then do
      v = ev(px_node[n*6+2], fb)
      if px_si[67] > 0 then return 0
      if v = 2 then do
        if px_node[n*6+3] > 0 then return ev(px_node[n*6+3], fb)
        return 2
      end
      if px_node[n*6+4] > 0 then do
        if px_node[n*6+6] >= 0 then vp[fb + 4 + px_node[n*6+6]] = v
        return ev(px_node[n*6+4], fb)
      end
      return v
    end
    when t = 27 then do
      do forever
        v = ev(px_node[n*6+2], fb)
        if px_si[67] > 0 then return 0
      end
      return 2
    end
    when t = 10 then return do_cascade(n, fb)
    when t = 12 then do
      v = newobj(px_si[56], 6, 0)
      px_obj[(v % 2)*5+5] = n
      px_obj[(v % 2)*5+4] = fb
      return v
    end
    when t = 15 then do
      c = px_node[n*6+3]
      v = mkarray(c)
      do i = 0 to c - 1
        f = ev(al[px_node[n*6+2] + i], fb)
        if px_si[67] > 0 then return 0
        sl[px_obj[(v % 2)*5+4] + i] = f
      end
      return v
    end
    when t = 16 then return make_context()
    otherwise nop
  end
  return 2

not_boolean: procedure = .int
  arg v = .int, sel = .string
  call st_error v, "doesNotUnderstand: #" || sel || " (receiver is not a Boolean)"
  return 0

not_number: procedure = .int
  arg v = .int, sel = .string
  call st_error v, "doesNotUnderstand: #" || sel
  return 0

do_todo: procedure = .int
  arg n = .int, fb = .int
  ev_n = .int
  ev_t = .int
  a = .int
  b = .int
  st = .int
  x = .int
  y = .int
  s = .int
  slot = .int
  v = .int
  r = .int
  base = .int
  ev_n = px_node[n*6+2]
  ev_t = px_node[ev_n*6+1]
  if ev_t = 1 then a = px_node[ev_n*6+2]
  else if ev_t = 2 then a = vp[fb + 2]
  else if ev_t = 3 & px_node[ev_n*6+2] = 0 then a = vp[fb + 4 + px_node[ev_n*6+3]]
  else a = ev(ev_n, fb)
  if px_si[67] > 0 then return 0
  ev_n = px_node[n*6+3]
  ev_t = px_node[ev_n*6+1]
  if ev_t = 1 then b = px_node[ev_n*6+2]
  else if ev_t = 2 then b = vp[fb + 2]
  else if ev_t = 3 & px_node[ev_n*6+2] = 0 then b = vp[fb + 4 + px_node[ev_n*6+3]]
  else b = ev(ev_n, fb)
  if px_si[67] > 0 then return 0
  if px_node[n*6+5] > 0 then do
    ev_n = px_node[n*6+5]
    ev_t = px_node[ev_n*6+1]
    if ev_t = 1 then st = px_node[ev_n*6+2]
    else if ev_t = 2 then st = vp[fb + 2]
    else if ev_t = 3 & px_node[ev_n*6+2] = 0 then st = vp[fb + 4 + px_node[ev_n*6+3]]
    else st = ev(ev_n, fb)
    if px_si[67] > 0 then return 0
  end
  else st = mkint(1)
  slot = fb + 4 + px_node[n*6+6]
  if a // 2 \= 0 & b // 2 \= 0 & st // 2 \= 0 then do
    x = intval(a)
    y = intval(b)
    s = intval(st)
    if s = 0 then do
      call st_error a, "step must be non-zero"
      return 0
    end
    if s > 0 then do
      do while x <= y
        vp[slot] = mkint(x)
        v = ev(px_node[n*6+4], fb)
        if px_si[67] > 0 then return 0
        x = x + s
      end
    end
    else do
      do while x >= y
        vp[slot] = mkint(x)
        v = ev(px_node[n*6+4], fb)
        if px_si[67] > 0 then return 0
        x = x + s
      end
    end
    return a
  end
  /* general numbers: use sends */
  base = px_si[64]
  v = a
  do forever
    px_si[64] = base + 1
    ast[px_si[64]] = b
    if is_neg(st) = 0 then r = send_sel(v, 9, base, 1)
    else r = send_sel(v, 10, base, 1)
    px_si[64] = base
    if px_si[67] > 0 then return 0
    if r \= 4 then leave
    vp[slot] = v
    r = ev(px_node[n*6+4], fb)
    if px_si[67] > 0 then return 0
    px_si[64] = base + 1
    ast[px_si[64]] = st
    v = send_sel(v, 1, base, 1)
    px_si[64] = base
    if px_si[67] > 0 then return 0
  end
  return a

is_neg: procedure = .int
  arg x = .int
  if x // 2 \= 0 then do
    if intval(x) < 0 then return 1
    return 0
  end
  if px_obj[(x % 2)*5+2] = 3 then do
    if o_f[x % 2] < 0.0 then return 1
  end
  return 0

do_cascade: procedure = .int
  arg n = .int, fb = .int
  rcv = .int
  i = .int
  k = .int
  j = .int
  base = .int
  v = .int
  r = .int
  f = .int
  rcv = ev(px_node[n*6+2], fb)
  if px_si[67] > 0 then return 0
  r = 2
  do i = px_node[n*6+3] to px_node[n*6+3] + px_node[n*6+4] - 1
    k = al[i]
    base = px_si[64]
    do j = 0 to px_node[k*6+6] - 1
      v = ev(al[px_node[k*6+3] + j], fb)
      if px_si[67] > 0 then do
        px_si[64] = base
        return 0
      end
      px_si[64] = px_si[64] + 1
      ast[px_si[64]] = v
    end
    r = send_sel(rcv, px_node[k*6+4], base, px_node[k*6+6])
    px_si[64] = base
    if px_si[67] > 0 then return 0
  end
  return r

do_send: procedure = .int
  arg n = .int, fb = .int
  ev_n = .int
  ev_t = .int
  rn = .int
  sel = .int
  na = .int
  rcv = .int
  c = .int
  m = .int
  i = .int
  base = .int
  v = .int
  x = .int
  y = .int
  r = .int
  f = .int
  rn = px_node[n*6+2]
  sel = px_node[n*6+4]
  na = px_node[n*6+6]
  if px_node[n*6+5] = 1 then do
    rcv = vp[fb + 2]
    c = px_cls[(px_meth[(vp[fb + 3])*8+2])*8+1]
    if c = 0 then c = px_si[45]
  end
  else do
    ev_n = rn
    ev_t = px_node[ev_n*6+1]
    if ev_t = 1 then rcv = px_node[ev_n*6+2]
    else if ev_t = 2 then rcv = vp[fb + 2]
    else if ev_t = 3 & px_node[ev_n*6+2] = 0 then rcv = vp[fb + 4 + px_node[ev_n*6+3]]
    else rcv = ev(ev_n, fb)
    if px_si[67] > 0 then return 0
    c = 0
  end
  base = px_si[64]
  f = px_node[n*6+3]
  do i = 0 to na - 1
    ev_n = al[f + i]
    ev_t = px_node[ev_n*6+1]
    if ev_t = 1 then v = px_node[ev_n*6+2]
    else if ev_t = 2 then v = vp[fb + 2]
    else if ev_t = 3 & px_node[ev_n*6+2] = 0 then v = vp[fb + 4 + px_node[ev_n*6+3]]
    else v = ev(ev_n, fb)
    if px_si[67] > 0 then do
      px_si[64] = base
      return 0
    end
    px_si[64] = px_si[64] + 1
    ast[px_si[64]] = v
  end
  /* fast paths for SmallInteger arithmetic and comparison */
  if na = 1 & sel <= 14 then do
    v = ast[px_si[64]]
    if rcv // 2 \= 0 & v // 2 \= 0 then do
      x = intval(rcv)
      y = intval(v)
      select
        when sel = 1 then do
          r = x + y
          if r > -1000000000000000000 & r < 1000000000000000000 then do
            px_si[64] = base
            return r * 2 + 1
          end
        end
        when sel = 2 then do
          r = x - y
          if r > -1000000000000000000 & r < 1000000000000000000 then do
            px_si[64] = base
            return r * 2 + 1
          end
        end
        when sel = 3 then do
          if x > -1000000000 & x < 1000000000 & y > -1000000000 & y < 1000000000 then do
            px_si[64] = base
            return (x * y) * 2 + 1
          end
        end
        when sel = 7 then do
          px_si[64] = base
          if x < y then return 4
          return 6
        end
        when sel = 8 then do
          px_si[64] = base
          if x > y then return 4
          return 6
        end
        when sel = 9 then do
          px_si[64] = base
          if x <= y then return 4
          return 6
        end
        when sel = 10 then do
          px_si[64] = base
          if x >= y then return 4
          return 6
        end
        when sel = 11 then do
          px_si[64] = base
          if x = y then return 4
          return 6
        end
        when sel = 12 then do
          px_si[64] = base
          if x \= y then return 4
          return 6
        end
        when sel = 5 then do
          if y \= 0 then do
            r = x % y
            if (x // y \= 0) & ((x < 0) \= (y < 0)) then r = r - 1
            px_si[64] = base
            return r * 2 + 1
          end
        end
        when sel = 6 then do
          if y \= 0 then do
            r = x // y
            if r \= 0 & ((r < 0) \= (y < 0)) then r = r + y
            px_si[64] = base
            return r * 2 + 1
          end
        end
        otherwise nop
      end
    end
    if sel = 13 then do
      px_si[64] = base
      if rcv = v then return 4
      return 6
    end
    if sel = 14 then do
      px_si[64] = base
      if rcv = v then return 6
      return 4
    end
  end
  if c = 0 then c = cof(rcv)
  m = lookup(c, sel)
  if m = 0 then r = send_dnu(rcv, sel, base, na)
  else r = invoke(m, rcv, base, na)
  px_si[64] = base
  return r

/* thisContext: a chain of Context objects built from the call stack */
make_context: procedure = .int
  cc = .int
  i = .int
  o = .int
  prev = .int
  s0 = .int
  cc = find_class("Context")
  if cc = 0 then return 2
  prev = 2
  do i = 1 to px_si[65]
    o = new_instance(cc, 0)
    s0 = px_obj[(o % 2)*5+4]
    sl[s0] = px_h[i*5+2]
    sl[s0 + 1] = mksym(px_str[(px_meth[(px_h[i*5+1])*8+1])*8+8])
    sl[s0 + 2] = px_cls[(px_meth[(px_h[i*5+1])*8+2])*8+8]
    sl[s0 + 3] = prev
    prev = o
  end
  if prev = 2 then do
    o = new_instance(cc, 0)
    s0 = px_obj[(o % 2)*5+4]
    sl[s0] = 2
    sl[s0 + 1] = mksym("executeStatements")
    sl[s0 + 2] = 2
    sl[s0 + 3] = 2
    prev = o
  end
  return prev


/* ---------------------------------------------------------------------
   Number helpers
   --------------------------------------------------------------------- */
numkind: procedure = .int
  arg x = .int
  k = .int
  if x // 2 \= 0 then return 1
  k = px_obj[(x % 2)*5+2]
  if k = 7 then return 2
  if k = 3 then return 3
  return 0

tofloat: procedure = .float
  arg x = .int
  if x // 2 \= 0 then return intval(x) as .float
  if px_obj[(x % 2)*5+2] = 7 then return o_s[x % 2] as .float
  return o_f[x % 2]

float_int: procedure = .int
  arg f = .float
  if f \= f then return 0
  if f > 1.0e308 | f < -1.0e308 then return 0
  if f > -900000000000000000.0 & f < 900000000000000000.0 then return mkint(rxfloat..trunc(f) as .int)
  return big_norm(float_to_istr(f))

f_inf: procedure = .float
  z = .float
  z = 1.0e308
  z = z * 10.0
  return z

f_nan: procedure = .float
  z = .float
  z = f_inf()
  return z - z

float_str: procedure = .string
  arg f = .float
  s = .string
  p = .int
  if f \= f then return "nan"
  if f > 1.0e308 then return "inf"
  if f < -1.0e308 then return "-inf"
  s = f as .string
  p = pos("e", s)
  if p = 0 then do
    if pos(".", s) = 0 then s = s || ".0"
    return s
  end
  if pos(".", left(s, p - 1)) = 0 then s = left(s, p - 1) || ".0" || substr(s, p)
  s = translate(s, "", "+")
  return s

/* arithmetic on numbers; op: 1 add 2 sub 3 mul 4 div 5 idiv 6 mod 7 quo 8 rem */
p_arith: procedure = .int
  arg op = .int, x = .int, y = .int
  kx = .int
  ky = .int
  fx = .float
  fy = .float
  q = .float
  a = .int
  b = .int
  r = .int
  sx = .string
  sy = .string
  kx = numkind(x)
  ky = numkind(y)
  if kx = 0 | ky = 0 then return 0
  if kx = 3 | ky = 3 then do
    fx = tofloat(x)
    fy = tofloat(y)
    select
      when op = 1 then return mkfloat(fx + fy)
      when op = 2 then return mkfloat(fx - fy)
      when op = 3 then return mkfloat(fx * fy)
      when op = 4 then do
        if fy = 0.0 then return 0
        return mkfloat(fx / fy)
      end
      otherwise do
        if fy = 0.0 then return 0
        if op = 5 then return float_int(rxfloat..floor(fx / fy))
        if op = 6 then return mkfloat(fx - fy * rxfloat..floor(fx / fy))
        if op = 7 then return float_int(rxfloat..trunc(fx / fy))
        return mkfloat(fx - fy * rxfloat..trunc(fx / fy))
      end
    end
  end
  if kx = 1 & ky = 1 then do
    a = intval(x)
    b = intval(y)
    select
      when op = 1 then return big_norm0(a + b)
      when op = 2 then return big_norm0(a - b)
      when op = 3 then do
        fx = a as .float
        fy = b as .float
        if rxfloat..fabs(fx * fy) < 900000000000000000.0 then return mkint(a * b)
        return big_norm(smul(a as .string, b as .string))
      end
      otherwise do
        if b = 0 then return 0
        if op = 4 then do
          if a // b = 0 then return mkint(a % b)
          return 0
        end
        r = a % b
        if op = 5 then do
          if a // b \= 0 & ((a < 0) \= (b < 0)) then r = r - 1
          return mkint(r)
        end
        if op = 6 then do
          r = a // b
          if r \= 0 & ((r < 0) \= (b < 0)) then r = r + b
          return mkint(r)
        end
        if op = 7 then return mkint(r)
        return mkint(a // b)
      end
    end
  end
  sx = num_str(x)
  sy = num_str(y)
  select
    when op = 1 then return big_norm(sadd(sx, sy))
    when op = 2 then return big_norm(ssub(sx, sy))
    when op = 3 then return big_norm(smul(sx, sy))
    otherwise do
      if sy == "0" then return 0
      call sdivmod sx, sy
      if op = 4 then do
        if px_ss[14] == "0" then return big_norm(px_ss[13])
        return 0
      end
      if op = 7 then return big_norm(px_ss[13])
      if op = 8 then return big_norm(px_ss[14])
      /* floor division and modulo */
      if px_ss[14] \== "0" & ((left(sx, 1) == "-") \= (left(sy, 1) == "-")) then do
        if op = 5 then return big_norm(ssub(px_ss[13], "1"))
        return big_norm(sadd(px_ss[14], sy))
      end
      if op = 5 then return big_norm(px_ss[13])
      return big_norm(px_ss[14])
    end
  end
  return 0

big_norm0: procedure = .int
  arg v = .int
  if v > -1000000000000000000 & v < 1000000000000000000 then return mkint(v)
  return big_norm(v as .string)

/* comparison: returns -1/0/1, or 2 when not comparable */
p_cmp: procedure = .int
  arg x = .int, y = .int
  kx = .int
  ky = .int
  fx = .float
  fy = .float
  kx = numkind(x)
  ky = numkind(y)
  if kx = 0 | ky = 0 then return 2
  if kx = 3 | ky = 3 then do
    fx = tofloat(x)
    fy = tofloat(y)
    if fx < fy then return -1
    if fx > fy then return 1
    if fx = fy then return 0
    return 2
  end
  if kx = 1 & ky = 1 then do
    if intval(x) < intval(y) then return -1
    if intval(x) > intval(y) then return 1
    return 0
  end
  return scmp(num_str(x), num_str(y))

/* ---------------------------------------------------------------------
   Dictionaries
   --------------------------------------------------------------------- */
dkey: procedure = .string
  arg x = .int
  k = .int
  if x // 2 \= 0 then return "i" || intval(x)
  k = px_obj[(x % 2)*5+2]
  select
    when k = 1 then return "s" || o_s[x % 2]
    when k = 2 then return "y" || o_s[x % 2]
    when k = 7 then return "i" || o_s[x % 2]
    when k = 3 then do
      if o_f[x % 2] = rxfloat..trunc(o_f[x % 2]) & rxfloat..fabs(o_f[x % 2]) < 900000000000000000.0 then return "i" || (rxfloat..trunc(o_f[x % 2]) as .int)
      return "f" || o_f[x % 2]
    end
    when k = 5 then return "c" || px_obj[(x % 2)*5+5]
    otherwise nop
  end
  return "o" || x

dict_new: procedure = .int
  arg c = .int
  o = .int
  d = .int
  px_si[73] = px_si[73] + 1
  d = px_si[73]
  px_dd[d*7+1] = 0
  px_dd[d*7+2] = 0
  px_dd[d*7+3] = 0
  o = newobj(c, 8, px_cls[c*8+6])
  px_obj[(o % 2)*5+5] = d
  return o

dict_find: procedure = .int
  arg o = .int, key = .int
  v = .string
  v = dmap[px_obj[(o % 2)*5+5] || "|" || dkey(key)]
  if v == "" then return 0
  return v as .int

dict_put: procedure = .void
  arg o = .int, key = .int, val = .int
  e = .int
  d = .int
  e = dict_find(o, key)
  if e > 0 then do
    px_dd[e*7+5] = val
    return
  end
  d = px_obj[(o % 2)*5+5]
  px_si[74] = px_si[74] + 1
  px_dd[(px_si[74])*7+4] = key
  px_dd[(px_si[74])*7+5] = val
  px_dd[(px_si[74])*7+6] = 0
  px_dd[(px_si[74])*7+7] = 1
  if px_dd[d*7+2] = 0 then px_dd[d*7+1] = px_si[74]
  else px_dd[(px_dd[d*7+2])*7+6] = px_si[74]
  px_dd[d*7+2] = px_si[74]
  px_dd[d*7+3] = px_dd[d*7+3] + 1
  dmap[d || "|" || dkey(key)] = px_si[74]
  return

dict_remove: procedure = .int
  arg o = .int, key = .int
  e = .int
  d = .int
  e = dict_find(o, key)
  if e = 0 then return 0
  d = px_obj[(o % 2)*5+5]
  px_dd[e*7+7] = 0
  px_dd[d*7+3] = px_dd[d*7+3] - 1
  dmap[d || "|" || dkey(key)] = ""
  return e

/* ---------------------------------------------------------------------
   Exceptions
   --------------------------------------------------------------------- */
/* does handler class spec h (class or ExceptionSet array) match exception ex ? */
exc_matches: procedure = .int
  arg h = .int, ex = .int
  c = .int
  i = .int
  n = .int
  if h // 2 \= 0 then return 0
  if px_obj[(h % 2)*5+2] = 9 then return inherits(cof(ex), px_obj[(h % 2)*5+5])
  if px_obj[(h % 2)*5+2] = 4 then do
    n = px_obj[(h % 2)*5+3]
    do i = 0 to n - 1
      if exc_matches(sl[px_obj[(h % 2)*5+4] + i], ex) = 1 then return 1
    end
  end
  return 0

/* signal ex, looking for handlers from index start downwards */
do_signal: procedure = .int
  arg ex = .int, start = .int, fresh = .int
  k = .int
  sig = .int
  oldtop = .int
  v = .int
  hb = .int
  base = .int
  m = .int
  if fresh = 1 then do
    px_si[72] = px_si[72] + 1
    sig = px_si[72]
    call slot_put ex, 2, mkint(sig)
  end
  else sig = intval(slot_get(ex, 2))
  k = 0
  do v = start to 1 by -1
    if exc_matches(px_h[v*5+3], ex) = 1 then do
      k = v
      leave
    end
  end
  if k = 0 then do
    /* unhandled */
    base = px_si[64]
    v = send_sel(ex, 27, base, 0)
    px_si[64] = base
    if px_si[67] > 0 then return 0
    return v
  end
  oldtop = px_si[70]
  px_si[70] = k - 1
  call slot_put ex, 1, mkint(k)
  hb = px_h[k*5+4]
  base = px_si[64]
  if px_node[(px_obj[(hb % 2)*5+5])*6+3] = 0 then v = call_block(hb, base, 0)
  else do
    px_si[64] = px_si[64] + 1
    ast[px_si[64]] = ex
    v = call_block(hb, base, 1)
    px_si[64] = base
  end
  px_si[70] = oldtop
  if px_si[67] = 0 then do
    /* the handler block completed: return its value from on:do: */
    px_si[67] = 2
    px_si[68] = px_h[k*5+5]
    px_si[69] = v
    return 0
  end
  if px_si[67] = 4 & px_si[68] = sig then do
    px_si[67] = 0
    return px_si[69]
  end
  return 0

/* ---------------------------------------------------------------------
   Primitive dispatch
   --------------------------------------------------------------------- */
prim: procedure = .int
  arg p = .int, rcv = .int, base = .int, na = .int
  if p >= 161 then return prim_net(p, rcv, base, na)
  if p < 51 then return prim_a(p, rcv, base, na)
  if p < 88 then return prim_b(p, rcv, base, na)
  return prim_c(p, rcv, base, na)

/* numbers, objects, reflection */
prim_a: procedure = .int
  arg p = .int, rcv = .int, base = .int, na = .int
  a1 = .int
  a2 = .int
  r = .int
  c = .int
  i = .int
  k = .int
  s = .string
  x = .float
  o = .int
  a1 = ast[base + 1]
  a2 = ast[base + 2]
  select
    when p = 1 then return p_arith(1, rcv, a1)
    when p = 2 then return p_arith(2, rcv, a1)
    when p = 3 then return p_arith(3, rcv, a1)
    when p = 4 then return p_arith(4, rcv, a1)
    when p = 5 then return p_arith(5, rcv, a1)
    when p = 6 then return p_arith(6, rcv, a1)
    when p = 7 then return p_arith(7, rcv, a1)
    when p = 8 then return p_arith(8, rcv, a1)
    when p = 9 | p = 10 | p = 11 | p = 12 then do
      r = p_cmp(rcv, a1)
      if r = 2 then return 0
      if p = 9 then return mkbool(r < 0)
      if p = 10 then return mkbool(r > 0)
      if p = 11 then return mkbool(r <= 0)
      return mkbool(r >= 0)
    end
    when p = 13 | p = 14 then do
      r = p_cmp(rcv, a1)
      if p = 13 then return mkbool(r = 0)
      return mkbool(r \= 0)
    end
    when p = 15 then return mkbool(rcv = a1)
    when p = 16 then return mkbool(rcv \= a1)
    when p = 17 then return px_cls[(cof(rcv))*8+8]
    when p = 18 then do
      if rcv // 2 \= 0 then return mkint(0)
      k = px_obj[(rcv % 2)*5+2]
      if k = 1 | k = 2 then return mkint(length(o_s[rcv % 2]))
      if k = 4 | k = 0 then return mkint(px_obj[(rcv % 2)*5+3] - px_cls[(px_obj[(rcv % 2)*5+1])*8+6])
      return mkint(0)
    end
    when p = 19 then do
      if rcv // 2 \= 0 | a1 // 2 = 0 then return 0
      i = intval(a1)
      k = px_obj[(rcv % 2)*5+2]
      if k = 1 | k = 2 then do
        if i < 1 | i > length(o_s[rcv % 2]) then return 0
        return mkchar(c2d(substr(o_s[rcv % 2], i, 1)))
      end
      c = px_cls[(px_obj[(rcv % 2)*5+1])*8+6]
      if i < 1 | i > px_obj[(rcv % 2)*5+3] - c then return 0
      return sl[px_obj[(rcv % 2)*5+4] + c + i - 1]
    end
    when p = 20 then do
      if rcv // 2 \= 0 | a1 // 2 = 0 then return 0
      i = intval(a1)
      k = px_obj[(rcv % 2)*5+2]
      if k = 1 then do
        if i < 1 | i > length(o_s[rcv % 2]) | a2 // 2 \= 0 then return 0
        if px_obj[(a2 % 2)*5+2] \= 5 then return 0
        o_s[rcv % 2] = left(o_s[rcv % 2], i - 1) || d2c(px_obj[(a2 % 2)*5+5]) || substr(o_s[rcv % 2], i + 1)
        return a2
      end
      if k = 2 then return 0
      c = px_cls[(px_obj[(rcv % 2)*5+1])*8+6]
      if i < 1 | i > px_obj[(rcv % 2)*5+3] - c then return 0
      sl[px_obj[(rcv % 2)*5+4] + c + i - 1] = a2
      return a2
    end
    when p = 21 then do
      if rcv // 2 \= 0 | a1 // 2 = 0 then return 0
      i = intval(a1)
      if i < 1 | i > px_obj[(rcv % 2)*5+3] then return 0
      return sl[px_obj[(rcv % 2)*5+4] + i - 1]
    end
    when p = 22 then do
      if rcv // 2 \= 0 | a1 // 2 = 0 then return 0
      i = intval(a1)
      if i < 1 | i > px_obj[(rcv % 2)*5+3] then return 0
      sl[px_obj[(rcv % 2)*5+4] + i - 1] = a2
      return a2
    end
    when p = 23 then do
      if rcv // 2 \= 0 then return rcv
      return mkint(rcv % 2)
    end
    when p = 24 | p = 25 then do
      s = strof(a1)
      if s == "" | isstr(a1) = 0 then return 0
      k = selid(s)
      if p = 24 then do
        /* shift the arguments down one place */
        do i = 2 to na
          ast[base + i - 1] = ast[base + i]
        end
        px_si[64] = base + na - 1
        r = send_sel(rcv, k, base, na - 1)
        px_si[64] = base
        return r
      end
      if a2 // 2 \= 0 then return 0
      c = px_obj[(a2 % 2)*5+3]
      px_si[64] = base
      do i = 0 to c - 1
        px_si[64] = px_si[64] + 1
        ast[px_si[64]] = sl[px_obj[(a2 % 2)*5+4] + i]
      end
      r = send_sel(rcv, k, base, c)
      px_si[64] = base
      return r
    end
    when p = 26 then do
      if a1 // 2 \= 0 then return 0
      if px_obj[(a1 % 2)*5+2] \= 9 & px_obj[(a1 % 2)*5+2] \= 10 then return 0
      return mkbool(inherits(cof(rcv), px_obj[(a1 % 2)*5+5]))
    end
    when p = 27 then do
      if a1 // 2 \= 0 then return 0
      return mkbool(cof(rcv) = px_obj[(a1 % 2)*5+5])
    end
    when p = 28 then do
      s = strof(a1)
      if isstr(a1) = 0 then return 0
      return mkbool(lookup(cof(rcv), selid(s)) > 0)
    end
    when p = 29 then return shallow_copy(rcv)
    when p = 30 then do
      if rcv // 2 \= 0 then return 0
      return new_instance(px_obj[(rcv % 2)*5+5], 0)
    end
    when p = 31 then do
      if rcv // 2 \= 0 | a1 // 2 = 0 then return 0
      if intval(a1) < 0 then return 0
      return new_instance(px_obj[(rcv % 2)*5+5], intval(a1))
    end
    when p = 32 then do
      if a1 // 2 = 0 then return 0
      k = intval(a1)
      if numkind(rcv) = 0 then return 0
      x = tofloat(rcv)
      select
        when k = 1 then do
          if x < 0.0 then return mkfloat(f_nan())
          return mkfloat(rxfloat..sqrt(x))
        end
        when k = 2 then return mkfloat(rxfloat..sin(x))
        when k = 3 then return mkfloat(rxfloat..cos(x))
        when k = 4 then return mkfloat(rxfloat..tan(x))
        when k = 5 then return mkfloat(rxfloat..atan(x))
        when k = 6 then do
          if x < 0.0 then return mkfloat(f_nan())
          if x = 0.0 then return mkfloat(0.0 - f_inf())
          return mkfloat(rxfloat..log(x))
        end
        when k = 7 then return mkfloat(rxfloat..exp(x))
        when k = 8 then do
          if x < 0.0 then return mkfloat(f_nan())
          if x = 0.0 then return mkfloat(0.0 - f_inf())
          return mkfloat(rxfloat..log10(x))
        end
        when k = 9 then return mkfloat(rxfloat..asin(x))
        when k = 10 then return mkfloat(rxfloat..acos(x))
        when k = 11 then do
          if numkind(a2) = 0 then return 0
          return mkfloat(rxfloat..pow(x, tofloat(a2)))
        end
        otherwise return 0
      end
    end
    when p = 33 | p = 34 | p = 35 | p = 36 then do
      k = numkind(rcv)
      if k = 1 | k = 2 then return rcv
      if k \= 3 then return 0
      x = o_f[rcv % 2]
      if p = 33 then return float_int(rxfloat..trunc(x))
      if p = 34 then return float_int(rxfloat..floor(x))
      if p = 35 then return float_int(rxfloat..ceil(x))
      if x >= 0.0 then return float_int(rxfloat..floor(x + 0.5))
      return float_int(rxfloat..ceil(x - 0.5))
    end
    when p = 37 then do
      if numkind(rcv) = 0 then return 0
      return mkfloat(tofloat(rcv))
    end
    when p = 38 | p = 39 | p = 40 then do
      if rcv // 2 = 0 | a1 // 2 = 0 then return 0
      return bitop(p, intval(rcv), intval(a1))
    end
    when p = 41 then do
      if rcv // 2 = 0 | a1 // 2 = 0 then return 0
      k = intval(a1)
      if k >= 0 then do
        o = rcv
        do i = 1 to k
          o = p_arith(3, o, mkint(2))
          if o = 0 then return 0
        end
        return o
      end
      o = rcv
      do i = 1 to 0 - k
        o = p_arith(5, o, mkint(2))
      end
      return o
    end
    when p = 42 then do
      k = numkind(rcv)
      if k = 1 then return mkstr(intval(rcv) as .string)
      if k = 2 then return mkstr(o_s[rcv % 2])
      if k = 3 then return mkstr(float_str(o_f[rcv % 2]))
      return 0
    end
    when p = 43 then do
      if numkind(rcv) \= 1 | a1 // 2 = 0 then return 0
      return mkstr(radix_str(intval(rcv), intval(a1)))
    end
    when p = 44 then do
      k = numkind(rcv)
      return mkbool(k = 1 | k = 2)
    end
    when p = 45 then return mkbool(numkind(rcv) = 3)
    when p = 46 then return mkbool(kindof(rcv) = 1 | kindof(rcv) = 2)
    when p = 47 then return mkbool(kindof(rcv) = 2)
    when p = 48 then return mkbool(kindof(rcv) = 5)
    when p = 49 then return mkbool(numkind(rcv) > 0)
    when p = 50 then do
      if numkind(rcv) \= 1 then return 0
      if intval(rcv) < 0 then return 0
      return mkint(rxfloat..floor(rxfloat..sqrt(intval(rcv) as .float)) as .int)
    end
    otherwise return 0
  end
  return 0

bitop: procedure = .int
  arg p = .int, x = .int, y = .int
  r = .int
  m = .int
  bx = .int
  byy = .int
  rb = .int
  if x < 0 | y < 0 then return 0
  r = 0
  m = 1
  do while x > 0 | y > 0
    bx = x // 2
    byy = y // 2
    rb = (bx + byy) // 2
    if p = 38 then rb = bx * byy
    if p = 39 then do
      rb = bx + byy
      if rb > 1 then rb = 1
    end
    r = r + rb * m
    m = m * 2
    x = x % 2
    y = y % 2
  end
  return mkint(r)

radix_str: procedure = .string
  arg n = .int, rdx = .int
  digs = .string
  s = .string
  neg = .int
  d = .int
  digs = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ"
  if rdx < 2 | rdx > 36 then rdx = 10
  neg = 0
  if n < 0 then do
    neg = 1
    n = 0 - n
  end
  if n = 0 then return "0"
  s = ""
  do while n > 0
    d = n // rdx
    s = substr(digs, d + 1, 1) || s
    n = n % rdx
  end
  if neg = 1 then s = "-" || s
  return s

shallow_copy: procedure = .int
  arg x = .int
  k = .int
  o = .int
  i = .int
  e = .int
  c = .int
  if x // 2 \= 0 then return x
  k = px_obj[(x % 2)*5+2]
  select
    when k = 1 then do
      o = newobj(px_obj[(x % 2)*5+1], 1, 0)
      o_s[o % 2] = o_s[x % 2]
      return o
    end
    when k = 2 | k = 5 | k = 9 | k = 10 | k = 6 then return x
    when k = 3 then return mkfloat(o_f[x % 2])
    when k = 7 then return x
    when k = 8 then do
      o = dict_new(px_obj[(x % 2)*5+1])
      e = px_dd[(px_obj[(x % 2)*5+5])*7+1]
      do while e > 0
        if px_dd[e*7+7] = 1 then call dict_put o, px_dd[e*7+4], px_dd[e*7+5]
        e = px_dd[e*7+6]
      end
      do i = 0 to px_obj[(x % 2)*5+3] - 1
        sl[px_obj[(o % 2)*5+4] + i] = sl[px_obj[(x % 2)*5+4] + i]
      end
      return o
    end
    otherwise nop
  end
  o = newobj(px_obj[(x % 2)*5+1], k, px_obj[(x % 2)*5+3])
  do i = 0 to px_obj[(x % 2)*5+3] - 1
    sl[px_obj[(o % 2)*5+4] + i] = sl[px_obj[(x % 2)*5+4] + i]
  end
  px_obj[(o % 2)*5+5] = px_obj[(x % 2)*5+5]
  return o

/* new instance of class c, with n indexed slots */
new_instance: procedure = .int
  arg c = .int, n = .int
  k = .int
  o = .int
  k = px_cls[c*8+5]
  select
    when k = 0 then do
      if n > 0 then return newobj(c, 4, px_cls[c*8+6] + n)
      return newobj(c, 0, px_cls[c*8+6])
    end
    when k = 4 then return newobj(c, 4, px_cls[c*8+6] + n)
    when k = 1 then do
      o = newobj(c, 1, 0)
      o_s[o % 2] = copies(" ", n)
      return o
    end
    when k = 8 then return dict_new(c)
    when k = 3 then return mkfloat(0.0)
    otherwise return 0
  end
  return 0

/* strings, symbols, characters, arrays, dictionaries */
prim_b: procedure = .int
  arg p = .int, rcv = .int, base = .int, na = .int
  acc = .string
  a1 = .int
  a2 = .int
  a3 = .int
  s = .string
  t = .string
  i = .int
  j = .int
  k = .int
  r = .int
  n = .int
  o = .int
  e = .int
  c = .int
  a1 = ast[base + 1]
  a2 = ast[base + 2]
  a3 = ast[base + 3]
  select
    when p = 51 then do
      if isstr(rcv) = 0 then return 0
      return mkint(length(o_s[rcv % 2]))
    end
    when p = 52 then do
      if isstr(rcv) = 0 | a1 // 2 = 0 then return 0
      i = intval(a1)
      if i < 1 | i > length(o_s[rcv % 2]) then return 0
      return mkchar(c2d(substr(o_s[rcv % 2], i, 1)))
    end
    when p = 53 then do
      if kindof(rcv) \= 1 | a1 // 2 = 0 then return 0
      i = intval(a1)
      if i < 1 | i > length(o_s[rcv % 2]) | kindof(a2) \= 5 then return 0
      o_s[rcv % 2] = left(o_s[rcv % 2], i - 1) || d2c(px_obj[(a2 % 2)*5+5]) || substr(o_s[rcv % 2], i + 1)
      return a2
    end
    when p = 54 then do
      if isstr(rcv) = 0 | isstr(a1) = 0 then return 0
      return mkstr(o_s[rcv % 2] || o_s[a1 % 2])
    end
    when p = 55 then do
      if isstr(rcv) = 0 | a1 // 2 = 0 | a2 // 2 = 0 then return 0
      i = intval(a1)
      j = intval(a2)
      if j < i then do
        if i >= 1 & i <= length(o_s[rcv % 2]) + 1 & j = i - 1 then return mkstr("")
        return 0
      end
      if i < 1 | j > length(o_s[rcv % 2]) then return 0
      return mkstr(substr(o_s[rcv % 2], i, j - i + 1))
    end
    when p = 56 then do
      if isstr(rcv) = 0 | isstr(a1) = 0 then return 6
      if px_obj[(rcv % 2)*5+2] \= px_obj[(a1 % 2)*5+2] then return 6
      return mkbool(o_s[rcv % 2] == o_s[a1 % 2])
    end
    when p = 57 | p = 135 then do
      if isstr(rcv) = 0 | isstr(a1) = 0 then return 0
      s = o_s[rcv % 2]
      t = o_s[a1 % 2]
      if p = 135 then do
        if s == t then return mkint(0)
        if s << t then return mkint(-1)
        return mkint(1)
      end
      return mkbool(s << t)
    end
    when p = 58 then do
      if isstr(rcv) = 0 then return 0
      s = o_s[rcv % 2]
      n = length(s)
      r = n
      do i = 1 to min(n, 24)
        r = (r * 31 + c2d(substr(s, i, 1))) // 1000000007
      end
      return mkint(r)
    end
    when p = 59 then do
      if isstr(rcv) = 0 then return 0
      return mksym(o_s[rcv % 2])
    end
    when p = 60 then do
      if isstr(rcv) = 0 then return 0
      if px_obj[(rcv % 2)*5+2] = 1 then return rcv
      return mkstr(o_s[rcv % 2])
    end
    when p = 61 then do
      if isstr(rcv) = 0 then return 0
      if kindof(rcv) = 2 then return mksym(upper(o_s[rcv % 2]))
      return mkstr(upper(o_s[rcv % 2]))
    end
    when p = 62 then do
      if isstr(rcv) = 0 then return 0
      if kindof(rcv) = 2 then return mksym(lower(o_s[rcv % 2]))
      return mkstr(lower(o_s[rcv % 2]))
    end
    when p = 63 then do
      if isstr(rcv) = 0 then return 0
      if kindof(a1) = 5 then return mkint(pos(d2c(px_obj[(a1 % 2)*5+5]), o_s[rcv % 2]))
      if isstr(a1) = 1 then do
        if na >= 2 & a2 // 2 \= 0 then i = intval(a2)
        else i = 1
        if i < 1 then i = 1
        if o_s[a1 % 2] == "" then return mkint(0)
        return mkint(pos(o_s[a1 % 2], o_s[rcv % 2], i))
      end
      return 0
    end
    when p = 64 then do
      if isstr(rcv) = 0 | isstr(a1) = 0 | isstr(a2) = 0 then return 0
      s = o_s[rcv % 2]
      t = o_s[a1 % 2]
      if t == "" then return mkstr(s)
      acc = ""
      i = 1
      do forever
        j = pos(t, s, i)
        if j = 0 then leave
        acc = acc || substr(s, i, j - i) || o_s[a2 % 2]
        i = j + length(t)
      end
      return mkstr(acc || substr(s, i))
    end
    when p = 65 then do
      if isstr(rcv) = 0 then return 0
      return parse_number(o_s[rcv % 2])
    end
    when p = 66 then do
      if isstr(rcv) = 0 then return 0
      s = o_s[rcv % 2]
      i = verify(s, " " || '09'x || '0a'x || '0d'x, "N")
      if i = 0 then return mkstr("")
      j = length(s)
      do while j > i & pos(substr(s, j, 1), " " || '09'x || '0a'x || '0d'x) > 0
        j = j - 1
      end
      return mkstr(substr(s, i, j - i + 1))
    end
    when p = 67 then do
      if isstr(rcv) = 0 then return 0
      if na >= 1 & isstr(a1) = 1 then t = o_s[a1 % 2]
      else if na >= 1 & kindof(a1) = 5 then t = d2c(px_obj[(a1 % 2)*5+5])
      else t = " " || '09'x || '0a'x || '0d'x
      return split_str(o_s[rcv % 2], t)
    end
    when p = 68 then do
      if isstr(rcv) = 0 then return 0
      return mkstr(reverse(o_s[rcv % 2]))
    end
    when p = 69 then do
      if a1 // 2 = 0 then return 0
      return mkstr(copies(" ", max(0, intval(a1))))
    end
    when p = 70 then do
      if kindof(rcv) \= 5 then return 0
      return mkint(px_obj[(rcv % 2)*5+5])
    end
    when p = 71 then do
      if a1 // 2 = 0 then return 0
      i = intval(a1)
      if i < 0 | i > 255 then return 0
      return mkchar(i)
    end
    when p = 72 then do
      if a1 // 2 = 0 then return 0
      return mkarray(max(0, intval(a1)))
    end
    when p = 73 then do
      if rcv // 2 \= 0 | a1 // 2 = 0 then return 0
      if px_obj[(rcv % 2)*5+2] \= 4 then return 0
      i = intval(a1)
      c = px_cls[(px_obj[(rcv % 2)*5+1])*8+6]
      if i < 1 | i > px_obj[(rcv % 2)*5+3] - c then return 0
      return sl[px_obj[(rcv % 2)*5+4] + c + i - 1]
    end
    when p = 74 then do
      if rcv // 2 \= 0 | a1 // 2 = 0 then return 0
      if px_obj[(rcv % 2)*5+2] \= 4 then return 0
      i = intval(a1)
      c = px_cls[(px_obj[(rcv % 2)*5+1])*8+6]
      if i < 1 | i > px_obj[(rcv % 2)*5+3] - c then return 0
      sl[px_obj[(rcv % 2)*5+4] + c + i - 1] = a2
      return a2
    end
    when p = 75 then do
      if rcv // 2 \= 0 then return 0
      if px_obj[(rcv % 2)*5+2] \= 4 then return 0
      return mkint(px_obj[(rcv % 2)*5+3] - px_cls[(px_obj[(rcv % 2)*5+1])*8+6])
    end
    when p = 76 then do
      if rcv // 2 \= 0 | a1 // 2 = 0 | a2 // 2 = 0 then return 0
      if px_obj[(rcv % 2)*5+2] \= 4 then return 0
      i = intval(a1)
      j = intval(a2)
      c = px_cls[(px_obj[(rcv % 2)*5+1])*8+6]
      if j < i then do
        if j = i - 1 & i >= 1 then return mkarray(0)
        return 0
      end
      if i < 1 | j > px_obj[(rcv % 2)*5+3] - c then return 0
      r = mkarray(j - i + 1)
      do k = 0 to j - i
        sl[px_obj[(r % 2)*5+4] + k] = sl[px_obj[(rcv % 2)*5+4] + c + i - 1 + k]
      end
      return r
    end
    when p = 77 then do
      if rcv // 2 \= 0 then return 0
      if px_obj[(rcv % 2)*5+2] \= 4 then return 0
      c = px_cls[(px_obj[(rcv % 2)*5+1])*8+6]
      do k = c to px_obj[(rcv % 2)*5+3] - 1
        sl[px_obj[(rcv % 2)*5+4] + k] = a1
      end
      return rcv
    end
    when p = 78 then do
      /* replaceFrom: start to: stop with: coll startingAt: repStart */
      if rcv // 2 \= 0 | a1 // 2 = 0 | a2 // 2 = 0 | a3 // 2 \= 0 then return 0
      i = intval(a1)
      j = intval(a2)
      e = ast[base + 4]
      if e // 2 = 0 then return 0
      k = intval(e)
      n = j - i + 1
      if n <= 0 then return rcv
      if px_obj[(rcv % 2)*5+2] = 1 & isstr(a3) = 1 then do
        if i < 1 | j > length(o_s[rcv % 2]) | k < 1 | k + n - 1 > length(o_s[a3 % 2]) then return 0
        o_s[rcv % 2] = left(o_s[rcv % 2], i - 1) || substr(o_s[a3 % 2], k, n) || substr(o_s[rcv % 2], j + 1)
        return rcv
      end
      if px_obj[(rcv % 2)*5+2] = 4 & kindof(a3) = 4 then do
        c = px_cls[(px_obj[(rcv % 2)*5+1])*8+6]
        if i < 1 | j > px_obj[(rcv % 2)*5+3] - c | k < 1 | k + n - 1 > px_obj[(a3 % 2)*5+3] - px_cls[(px_obj[(a3 % 2)*5+1])*8+6] then return 0
        if rcv = a3 & k < i then do
          do e = n - 1 to 0 by -1
            sl[px_obj[(rcv % 2)*5+4] + c + i - 1 + e] = sl[px_obj[(a3 % 2)*5+4] + c + k - 1 + e]
          end
        end
        else do
          do e = 0 to n - 1
            sl[px_obj[(rcv % 2)*5+4] + c + i - 1 + e] = sl[px_obj[(a3 % 2)*5+4] + px_cls[(px_obj[(a3 % 2)*5+1])*8+6] + k - 1 + e]
          end
        end
        return rcv
      end
      return 0
    end
    when p = 79 then do
      if rcv // 2 \= 0 then return 0
      return dict_new(px_obj[(rcv % 2)*5+5])
    end
    when p = 80 then do
      if kindof(rcv) \= 8 then return 0
      e = dict_find(rcv, a1)
      if e = 0 then return 0
      return px_dd[e*7+5]
    end
    when p = 81 then do
      if kindof(rcv) \= 8 then return 0
      call dict_put rcv, a1, a2
      return a2
    end
    when p = 82 then do
      if kindof(rcv) \= 8 then return 0
      return mkbool(dict_find(rcv, a1) > 0)
    end
    when p = 83 then do
      if kindof(rcv) \= 8 then return 0
      e = dict_remove(rcv, a1)
      if e = 0 then return 0
      return px_dd[e*7+5]
    end
    when p = 84 | p = 85 then do
      if kindof(rcv) \= 8 then return 0
      n = px_dd[(px_obj[(rcv % 2)*5+5])*7+3]
      r = mkarray(n)
      e = px_dd[(px_obj[(rcv % 2)*5+5])*7+1]
      k = 0
      do while e > 0
        if px_dd[e*7+7] = 1 then do
          if p = 84 then sl[px_obj[(r % 2)*5+4] + k] = px_dd[e*7+4]
          else sl[px_obj[(r % 2)*5+4] + k] = px_dd[e*7+5]
          k = k + 1
        end
        e = px_dd[e*7+6]
      end
      return r
    end
    when p = 87 then do
      if kindof(rcv) \= 8 then return 0
      return shallow_copy(rcv)
    end
    when p = 86 then do
      if kindof(rcv) \= 8 then return 0
      return mkint(px_dd[(px_obj[(rcv % 2)*5+5])*7+3])
    end
    otherwise return 0
  end
  return 0

split_str: procedure = .int
  arg s = .string, seps = .string
  n = .int
  i = .int
  j = .int
  r = .int
  k = .int
  tmp = .string[]
  n = 0
  i = 1
  do while i <= length(s)
    /* skip separators */
    do while i <= length(s) & pos(substr(s, i, 1), seps) > 0
      i = i + 1
    end
    if i > length(s) then leave
    j = i
    do while j <= length(s) & pos(substr(s, j, 1), seps) = 0
      j = j + 1
    end
    n = n + 1
    tmp[n] = substr(s, i, j - i)
    i = j
  end
  r = mkarray(n)
  do k = 1 to n
    sl[px_obj[(r % 2)*5+4] + k - 1] = mkstr(tmp[k])
  end
  return r

parse_number: procedure = .int
  arg s0 = .string
  s = .string
  neg = .int
  q = .int
  p = .int
  isf = .int
  s = strip(s0)
  if s == "" then return 2
  neg = 0
  if left(s, 1) == "-" then do
    neg = 1
    s = substr(s, 2)
  end
  q = verify(s, "0123456789", "N")
  if q = 0 then do
    if s == "" then return 2
    if neg = 1 then s = "-" || s
    return big_norm(s)
  end
  if q = 1 then return 2
  /* real number */
  isf = 0
  if substr(s, q, 1) == "." & isdigit(substr(s, q + 1, 1)) = 1 then do
    p = verify(s, "0123456789", "N", q + 1)
    if p = 0 then p = length(s) + 1
    q = p
    isf = 1
  end
  if upper(substr(s, q, 1)) == "E" then do
    p = q + 1
    if substr(s, p, 1) == "-" | substr(s, p, 1) == "+" then p = p + 1
    q = verify(s, "0123456789", "N", p)
    if q = 0 then q = length(s) + 1
    isf = 1
  end
  s = left(s, q - 1)
  if isf = 1 then do
    if neg = 1 then return mkfloat(0.0 - (upper(s) as .float))
    return mkfloat(upper(s) as .float)
  end
  if neg = 1 then s = "-" || s
  return big_norm(s)

/* blocks, exceptions, classes, system */
prim_c: procedure = .int
  arg p = .int, rcv = .int, base = .int, na = .int
  a1 = .int
  a2 = .int
  s = .string
  t = .string
  i = .int
  j = .int
  k = .int
  r = .int
  n = .int
  o = .int
  e = .int
  c = .int
  v = .int
  id = .int
  oldtop = .int
  sv_u = .int
  sv_t = .int
  sv_v = .int
  b2 = .int
  a1 = ast[base + 1]
  a2 = ast[base + 2]
  select
    when p = 88 then do
      if kindof(rcv) \= 6 then return 0
      if px_node[(px_obj[(rcv % 2)*5+5])*6+3] \= na then do
        call st_error rcv, "wrong argument count"
        return 0
      end
      return call_block(rcv, base, na)
    end
    when p = 89 then do
      if kindof(rcv) \= 6 | kindof(a1) \= 4 then return 0
      n = px_obj[(a1 % 2)*5+3] - px_cls[(px_obj[(a1 % 2)*5+1])*8+6]
      if px_node[(px_obj[(rcv % 2)*5+5])*6+3] \= n then do
        call st_error rcv, "wrong argument count"
        return 0
      end
      b2 = px_si[64]
      do i = 0 to n - 1
        px_si[64] = px_si[64] + 1
        ast[px_si[64]] = sl[px_obj[(a1 % 2)*5+4] + px_cls[(px_obj[(a1 % 2)*5+1])*8+6] + i]
      end
      r = call_block(rcv, b2, n)
      px_si[64] = b2
      return r
    end
    when p = 90 then do
      if kindof(rcv) \= 6 then return 0
      return mkint(px_node[(px_obj[(rcv % 2)*5+5])*6+3])
    end
    when p = 91 | p = 92 then do
      if kindof(rcv) \= 6 then return 0
      do forever
        v = call_block(rcv, px_si[64], 0)
        if px_si[67] > 0 then return 0
        if p = 91 & v \= 4 then leave
        if p = 92 & v \= 6 then leave
        if na >= 1 then do
          v = call_block(a1, px_si[64], 0)
          if px_si[67] > 0 then return 0
        end
      end
      return 2
    end
    when p = 93 then do
      /* rcv on: exceptionClass do: handlerBlock */
      if kindof(rcv) \= 6 then return 0
      oldtop = px_si[70]
      do forever
        px_si[71] = px_si[71] + 1
        id = px_si[71]
        px_si[70] = oldtop + 1
        px_h[(px_si[70])*5+3] = a1
        px_h[(px_si[70])*5+4] = a2
        px_h[(px_si[70])*5+5] = id
        v = call_block(rcv, px_si[64], 0)
        px_si[70] = oldtop
        if px_si[67] = 2 & px_si[68] = id then do
          px_si[67] = 0
          return px_si[69]
        end
        if px_si[67] = 3 & px_si[68] = id then do
          px_si[67] = 0
          iterate
        end
        if px_si[67] > 0 then return 0
        return v
      end
    end
    when p = 94 | p = 95 then do
      if kindof(rcv) \= 6 then return 0
      v = call_block(rcv, px_si[64], 0)
      if p = 95 & px_si[67] = 0 then return v
      sv_u = px_si[67]
      sv_t = px_si[68]
      sv_v = px_si[69]
      oldtop = px_si[70]
      px_si[67] = 0
      r = call_block(a1, px_si[64], 0)
      px_si[70] = oldtop
      if px_si[67] = 0 then do
        px_si[67] = sv_u
        px_si[68] = sv_t
        px_si[69] = sv_v
      end
      if px_si[67] > 0 then return 0
      return v
    end
    when p = 96 then return do_signal(rcv, px_si[70], 1)
    when p = 97 then do
      /* rcv resume: value */
      px_si[67] = 4
      px_si[68] = intval(slot_get(rcv, 2))
      px_si[69] = a1
      return 0
    end
    when p = 98 then do
      k = intval(slot_get(rcv, 1))
      if k < 1 | k > px_si[70] + 50 then do
        call st_error rcv, "return: outside of a handler"
        return 0
      end
      px_si[67] = 2
      px_si[68] = px_h[k*5+5]
      px_si[69] = a1
      return 0
    end
    when p = 99 then do
      k = intval(slot_get(rcv, 1))
      px_si[67] = 3
      px_si[68] = px_h[k*5+5]
      px_si[69] = 2
      return 0
    end
    when p = 100 | p = 101 then do
      k = intval(slot_get(rcv, 1))
      v = do_signal(rcv, k - 1, 0)
      if px_si[67] > 0 then return 0
      if p = 100 then do
        px_si[67] = 2
        px_si[68] = px_h[k*5+5]
        px_si[69] = v
        return 0
      end
      return v
    end
    when p = 103 then do
      if rcv // 2 \= 0 then return 0
      return mkstr(px_str[(px_obj[(rcv % 2)*5+5])*8+5])
    end
    when p = 104 then do
      if rcv // 2 \= 0 then return 0
      k = px_cls[(px_obj[(rcv % 2)*5+5])*8+1]
      if k = 0 then return 2
      return px_cls[k*8+8]
    end
    when p = 105 then do
      if rcv // 2 \= 0 then return 0
      s = strof(a1)
      if s == "" then return 0
      return px_cls[(define_class(s, px_obj[(rcv % 2)*5+5]))*8+8]
    end
    when p = 106 then do
      s = strof(a1)
      if s == "" then return 0
      call add_ivar px_obj[(rcv % 2)*5+5], s
      return rcv
    end
    when p = 107 then do
      return mkstr(px_str[(px_obj[(rcv % 2)*5+5])*8+6])
    end
    when p = 108 then do
      k = px_obj[(rcv % 2)*5+5]
      n = 0
      do i = 1 to px_si[62]
        if cm[k * 2048 + i] > 0 then n = n + 1
      end
      r = mkarray(n)
      j = 0
      do i = 1 to px_si[62]
        if cm[k * 2048 + i] > 0 then do
          sl[px_obj[(r % 2)*5+4] + j] = mksym(px_str[i*8+8])
          j = j + 1
        end
      end
      return r
    end
    when p = 109 then do
      s = strof(a1)
      if s == "" then return 0
      return mkbool(cm[px_obj[(rcv % 2)*5+5] * 2048 + selid(s)] > 0)
    end
    when p = 112 then do
      s = strof(a1)
      if s == "" then return 0
      k = px_obj[(rcv % 2)*5+5]
      if px_cls[k*8+3] = 1 then k = px_cls[k*8+4]
      if cvmap[k || "." || s] == "" then do
        px_si[61] = px_si[61] + 1
        g_val[px_si[61]] = 2
        px_str[(px_si[61])*8+7] = s
        cvmap[k || "." || s] = px_si[61]
      end
      return rcv
    end
    when p = 113 then do
      s = strof(a1)
      if s == "" then return 0
      return mkbool(lookup(px_obj[(rcv % 2)*5+5], selid(s)) > 0)
    end
    when p = 114 then do
      k = px_obj[(rcv % 2)*5+5]
      n = 0
      do i = 1 to px_si[44]
        if px_cls[i*8+1] = k & px_cls[i*8+3] = 0 then n = n + 1
      end
      r = mkarray(n)
      j = 0
      do i = 1 to px_si[44]
        if px_cls[i*8+1] = k & px_cls[i*8+3] = 0 then do
          sl[px_obj[(r % 2)*5+4] + j] = px_cls[i*8+8]
          j = j + 1
        end
      end
      return r
    end
    when p = 116 then do
      s = strof(a1)
      if s == "" | gmap[s] == "" then return 0
      return g_val[gcell(s)]
    end
    when p = 117 then do
      s = strof(a1)
      if s == "" then return 0
      call gset s, a2
      return a2
    end
    when p = 118 then do
      s = strof(a1)
      if s == "" then return 0
      return mkbool(gmap[s] \== "")
    end
    when p = 119 then do
      if isstr(a1) = 1 then call outs o_s[a1 % 2]
      else if a1 // 2 \= 0 then call outs intval(a1) as .string
      else return 0
      return rcv
    end
    when p = 120 then do
      r = read_stdin_line()
      if r = 0 then return 2
      return r
    end
    when p = 121 then return mkbool(px_si[6] = 1)
    when p = 122 then do
      bdays = date("B") as .int
      usecs = time("US") as .int
      return mkint((bdays - 719162) * 86400000 + usecs % 1000)
    end
    when p = 137 then return mkint(0)
    when p = 123 then do
      call outs "halt" || '0a'x
      px_si[67] = 5
      return 0
    end
    when p = 124 then do
      if a1 // 2 \= 0 then px_si[1] = intval(a1)
      px_si[67] = 6
      return 0
    end
    when p = 126 then return mkbool(rcv = 2)
    when p = 128 then do
      if isstr(rcv) = 1 then return mkstr(o_s[rcv % 2])
      if numkind(rcv) > 0 then return prim_a(42, rcv, base, 0)
      if kindof(rcv) = 5 then return mkstr(d2c(px_obj[(rcv % 2)*5+5]))
      return 0
    end
    when p = 127 then do
      if isstr(a1) = 0 then return 0
      return eval_string(o_s[a1 % 2])
    end
    when p = 160 then do
      if isstr(a1) = 0 then return 0
      call file_in o_s[a1 % 2], "compile"
      return rcv
    end
    when p = 130 then do
      /* a1: 1 = print trace and abort, 2 = print trace only */
      call print_trace
      if a1 \= mkint(2) then px_si[67] = 5
      return 2
    end
    when p = 138 then do
      /* printString: with padding - unused */
      return 0
    end
    when p = 133 then do
      px_si[7] = (px_si[7] * 1103515245 + 12345) // 2147483648
      if px_si[7] < 0 then px_si[7] = 0 - px_si[7]
      if a1 // 2 \= 0 then do
        if intval(a1) > 0 then return mkint(px_si[7] // intval(a1) + 1)
      end
      return mkfloat(px_si[7] as .float / 2147483648.0)
    end
    when p = 145 then return mkint(px_si[10])
    when p = 146 then do
      if a1 // 2 = 0 then return 0
      ak = intval(a1)
      if ak < 1 | ak > px_si[10] then return 0
      return mkstr(sargs[ak])
    end
    when p = 147 then do
      if isstr(a1) = 0 then return 0
      return mkbool(rxfs..delete(o_s[a1 % 2]) = 0)
    end
    when p = 148 then do
      if isstr(a1) = 0 | isstr(a2) = 0 then return 0
      return mkbool(rxfs..rename(o_s[a1 % 2], o_s[a2 % 2]) = 0)
    end
    when p = 155 then do
      if isstr(a1) = 0 | isstr(a2) = 0 then return 0
      return mkbool(rxfs..copy(o_s[a1 % 2], o_s[a2 % 2]) = 0)
    end
    when p = 149 then do
      if isstr(a1) = 0 then return 0
      return mkint(rxfs..pathkind(o_s[a1 % 2]))
    end
    when p = 150 then do
      if isstr(a1) = 0 then return 0
      return mkbool(rxfs..mkdir(o_s[a1 % 2]) = 0)
    end
    when p = 151 then do
      if isstr(a1) = 0 then return 0
      return mkbool(rxfs..rmdir(o_s[a1 % 2]) = 0)
    end
    when p = 153 then return mkstr(rxfs..cwd())
    when p = 154 then do
      if isstr(a1) = 0 then return 0
      return mkbool(rxfs..chdir(o_s[a1 % 2]) = 0)
    end
    when p = 156 then do
      if isstr(a1) = 0 then return 0
      if file_ok(o_s[a1 % 2]) = 0 then return 2
      return mkint(file_bytes(o_s[a1 % 2]))
    end
    when p = 152 then do
      if isstr(a1) = 0 then return 0
      ents = .string[]
      cnt = rxfs..listdir(o_s[a1 % 2], ents)
      if cnt < 0 then return 2
      r = mkarray(cnt)
      do j = 1 to cnt
        sl[px_obj[(r % 2)*5+4] + j - 1] = mkstr(ents[j])
      end
      return r
    end
    when p = 157 then do
      if isstr(a1) = 0 then return 0
      return mkstr(run_command(o_s[a1 % 2]))
    end
    when p = 158 then return mkint(px_si[11])
    when p = 159 then return mkstr(px_ss[2])
    when p = 143 then do
      if a1 // 2 = 0 then return 0
      px_si[7] = intval(a1)
      if px_si[7] < 0 then px_si[7] = 0 - px_si[7]
      return rcv
    end
    when p = 144 then do
      if isstr(a1) = 0 then return 0
      return mkstr(getenv(o_s[a1 % 2]))
    end
    when p = 139 then do
      if isstr(a1) = 0 then return 0
      if file_ok(o_s[a1 % 2]) = 0 then return 2
      return mkstr(read_file_exact(o_s[a1 % 2]))
    end
    when p = 140 then do
      /* fileWrite: path text: string append: boolean */
      if isstr(a1) = 0 | isstr(a2) = 0 then return 0
      return mkbool(file_write(o_s[a1 % 2], o_s[a2 % 2], ast[base + 3] = 4))
    end
    when p = 141 then return mkstr(date("S"))
    when p = 142 then return mkstr(time("N"))
    when p = 132 then return 0
    when p = 131 then return 0
    otherwise return 0
  end
  return 0

read_stdin_line: procedure = .int
  line = .string
  e = .int
  if px_si[6] = 1 then return 0
  line = ""
  assembler freadline line, px_si[5]
  assembler feof e, px_si[5]
  if e > 0 & length(line) = 0 then do
    px_si[6] = 1
    return 0
  end
  if right(line, 1) == '0d'x then line = left(line, length(line) - 1)
  return mkstr(line)

/* evaluate a string of statements; the value of the last one is returned */
eval_string: procedure = .int
  arg text = .string
  sv_txt = .string
  sv_tp = .int
  sv_len = .int
  sv_tk = .int
  sv_ts = .string
  sv_ti = .int
  sv_tf = .float
  sv_tpos = .int
  sv_pkh = .int
  sv_pkt = .int
  sv_pks = .string
  sv_pki = .int
  sv_pkf = .float
  sv_pkp = .int
  sv_pe = .int
  seq = .int
  fb = .int
  v = .int
  sv_lvl = .int
  sv_envn = .int
  sv_cls = .int
  sv_nx = .int
  sv_txt = px_ss[5]
  sv_tp = px_si[12]
  sv_len = px_si[13]
  sv_tk = px_si[15]
  sv_ts = px_ss[7]
  sv_ti = px_si[16]
  sv_tf = px_sf[1]
  sv_tpos = px_si[17]
  sv_pkh = px_si[21]
  sv_pkt = px_si[22]
  sv_pks = px_ss[9]
  sv_pki = px_si[23]
  sv_pkf = px_sf[3]
  sv_pkp = px_si[24]
  sv_pe = px_si[14]
  sv_lvl = px_si[33]
  sv_envn = px_si[32]
  sv_cls = px_si[34]
  sv_nx = px_env[1*5+4]
  px_ss[5] = text
  px_si[12] = 1
  px_si[13] = length(text)
  px_si[21] = 0
  px_si[14] = 0
  call advance
  px_si[28] = 0
  if isbin("|") = 1 then px_si[28] = parse_temps()
  seq = parse_stmts(0)
  v = 2
  if px_si[14] = 0 then do
    call start_scope px_si[57]
    call rs_seq seq
    fb = alloc_frame(4 + px_env[1*5+4])
    vp[fb] = 0
    vp[fb + 1] = fb
    vp[fb + 2] = 2
    vp[fb + 3] = 0
    call init_temps fb + 4, px_env[1*5+4]
    v = ev(seq, fb)
    if px_si[67] = 1 then do
      px_si[67] = 0
      v = px_si[69]
    end
    if px_si[67] > 0 then v = 2
  end
  px_ss[5] = sv_txt
  px_si[12] = sv_tp
  px_si[13] = sv_len
  px_si[15] = sv_tk
  px_ss[7] = sv_ts
  px_si[16] = sv_ti
  px_sf[1] = sv_tf
  px_si[17] = sv_tpos
  px_si[21] = sv_pkh
  px_si[22] = sv_pkt
  px_ss[9] = sv_pks
  px_si[23] = sv_pki
  px_sf[3] = sv_pkf
  px_si[24] = sv_pkp
  px_si[14] = sv_pe
  px_si[33] = sv_lvl
  px_si[32] = sv_envn
  px_si[34] = sv_cls
  return v

file_ok: procedure = .int
  arg fn = .string
  fid = .int
  rcx = .int
  rmode = .string
  rmode = "r"
  fid = 0
  assembler fopen fid, fn, rmode
  if fid = 0 then return 0
  assembler fclose rcx, fid
  return 1

file_write: procedure = .int
  arg fn = .string, txt2 = .string, app = .int
  fid = .int
  rcx = .int
  wmode = .string
  wmode = "w"
  if app = 1 then wmode = "a"
  fid = 0
  assembler fopen fid, fn, wmode
  if fid = 0 then return 0
  assembler fwrite fid, txt2
  assembler fclose rcx, fid
  return 1

/* run a shell command; answers its standard output, sets sys_rc and sys_err */
run_command: procedure = .string
  arg cmd = .string
  outl = .string[]
  errl = .string[]
  res = .string
  i = .int
  res = ""
  address command cmd output outl error errl
  px_si[11] = rc
  do i = 1 to outl.0
    if i > 1 then res = res || '0a'x
    res = res || outl[i]
  end
  px_ss[2] = ""
  do i = 1 to errl.0
    if i > 1 then px_ss[2] = px_ss[2] || '0a'x
    px_ss[2] = px_ss[2] || errl[i]
  end
  return res

/* size of a file in bytes */
file_bytes: procedure = .int
  arg fn = .string
  b = .binary
  n = .int
  b = readbinary(fn)
  n = 0
  assembler blen n, b
  return n

/* the text of a file without the newline that read_file adds to an unterminated last line */
read_file_exact: procedure = .string
  arg fn = .string
  t = .string
  b = .binary
  n = .int
  lb = .int
  off = .int
  t = read_file(fn)
  if t == "" then return ""
  b = readbinary(fn)
  n = 0
  assembler blen n, b
  if n = 0 then return ""
  off = n - 1
  lb = 0
  assembler getbyte lb, b, off
  if lb \= 10 then t = left(t, length(t) - 1)
  return t

/* networking: sockets from the rxsocket library */
prim_net: procedure = .int
  arg p = .int, rcv = .int, base = .int, na = .int
  a1 = .int
  a2 = .int
  a3 = .int
  h = .int
  r = .int
  s = .string
  a1 = ast[base + 1]
  a2 = ast[base + 2]
  a3 = ast[base + 3]
  if p = 161 then return mkint(socketcreate())
  if a1 // 2 = 0 then return 0
  h = intval(a1)
  select
    when p = 162 then return mkint(socketclose(h))
    when p = 163 | p = 164 | p = 165 then do
      if isstr(a2) = 0 | a3 // 2 = 0 then return 0
      if p = 163 then r = socketconnect(h, o_s[a2 % 2], intval(a3))
      else if p = 164 then r = socketconnecttls(h, o_s[a2 % 2], intval(a3))
      else r = socketbind(h, o_s[a2 % 2], intval(a3))
      return mkint(r)
    end
    when p = 166 then do
      if a2 // 2 = 0 then return 0
      return mkint(socketlisten(h, intval(a2)))
    end
    when p = 167 then return mkint(socketaccept(h))
    when p = 168 then do
      if isstr(a2) = 0 then return 0
      return mkint(socketsend(h, o_s[a2 % 2]))
    end
    when p = 169 then do
      if a2 // 2 = 0 then return 0
      s = socketrecv(h, intval(a2))
      return mkstr(s)
    end
    when p = 170 then return mkint(socketpending(h))
    when p = 171 then do
      if a2 // 2 = 0 then return 0
      return mkint(sockettimeout(h, intval(a2)))
    end
    when p = 172 then return mkint(socketstatus(h))
    when p = 173 then return mkstr(socketerror(h))
    when p = 174 then return mkstr(socketpeer(h))
    when p = 175 then return mkstr(socketlocal(h))
    when p = 176 then do
      if a2 // 2 = 0 then return 0
      return mkint(socketnodelay(h, intval(a2)))
    end
    when p = 177 then do
      if a2 // 2 = 0 then return 0
      return mkint(socketshutdown(h, intval(a2)))
    end
    otherwise return 0
  end
  return 0


/* ---------------------------------------------------------------------
   Arbitrary-precision integers on decimal strings
   --------------------------------------------------------------------- */
mag_clean: procedure = .string
  arg s = .string
  p = .int
  p = verify(s, "0", "N")
  if p = 0 then return "0"
  return substr(s, p)

mag_cmp: procedure = .int
  arg a = .string, b = .string
  if length(a) < length(b) then return -1
  if length(a) > length(b) then return 1
  if a == b then return 0
  if a << b then return -1
  return 1

mag_add: procedure = .string
  arg a = .string, b = .string
  r = .string
  i = .int
  j = .int
  x = .int
  y = .int
  c = .int
  s = .int
  piece = .string
  i = length(a)
  j = length(b)
  c = 0
  r = ""
  do while i > 0 | j > 0 | c > 0
    x = 0
    y = 0
    if i > 0 then do
      if i > 9 then x = substr(a, i - 8, 9) as .int
      else x = substr(a, 1, i) as .int
      i = i - 9
    end
    if j > 0 then do
      if j > 9 then y = substr(b, j - 8, 9) as .int
      else y = substr(b, 1, j) as .int
      j = j - 9
    end
    s = x + y + c
    if s >= 1000000000 then do
      s = s - 1000000000
      c = 1
    end
    else c = 0
    piece = s as .string
    if i > 0 | j > 0 | c > 0 then piece = right(copies("0", 9) || piece, 9)
    r = piece || r
  end
  return mag_clean(r)

/* a >= b */
mag_sub: procedure = .string
  arg a = .string, b = .string
  r = .string
  i = .int
  j = .int
  x = .int
  y = .int
  c = .int
  s = .int
  piece = .string
  i = length(a)
  j = length(b)
  c = 0
  r = ""
  do while i > 0
    if i > 9 then x = substr(a, i - 8, 9) as .int
    else x = substr(a, 1, i) as .int
    i = i - 9
    y = 0
    if j > 0 then do
      if j > 9 then y = substr(b, j - 8, 9) as .int
      else y = substr(b, 1, j) as .int
      j = j - 9
    end
    s = x - y - c
    if s < 0 then do
      s = s + 1000000000
      c = 1
    end
    else c = 0
    piece = s as .string
    if i > 0 then piece = right(copies("0", 9) || piece, 9)
    r = piece || r
  end
  return mag_clean(r)

mag_mul: procedure = .string
  arg a = .string, b = .string
  la = .int
  lb = .int
  i = .int
  j = .int
  k = .int
  x = .int
  c = .int
  t = .int
  r = .string
  piece = .string
  al0 = .int[]
  bl0 = .int[]
  rl = .int[]
  if a == "0" | b == "0" then return "0"
  la = 0
  i = length(a)
  do while i > 0
    la = la + 1
    if i > 9 then al0[la] = substr(a, i - 8, 9) as .int
    else al0[la] = substr(a, 1, i) as .int
    i = i - 9
  end
  lb = 0
  i = length(b)
  do while i > 0
    lb = lb + 1
    if i > 9 then bl0[lb] = substr(b, i - 8, 9) as .int
    else bl0[lb] = substr(b, 1, i) as .int
    i = i - 9
  end
  do k = 1 to la + lb
    rl[k] = 0
  end
  do i = 1 to la
    c = 0
    x = al0[i]
    do j = 1 to lb
      t = x * bl0[j] + rl[i + j - 1] + c
      c = t % 1000000000
      rl[i + j - 1] = t // 1000000000
    end
    k = i + lb
    do while c > 0
      t = rl[k] + c
      c = t % 1000000000
      rl[k] = t // 1000000000
      k = k + 1
    end
  end
  k = la + lb
  do while k > 1 & rl[k] = 0
    k = k - 1
  end
  r = rl[k] as .string
  do i = k - 1 to 1 by -1
    piece = rl[i] as .string
    r = r || right(copies("0", 9) || piece, 9)
  end
  return mag_clean(r)

/* truncated division of magnitudes: quotient in bq, remainder in brm */
mag_divmod: procedure = .void
  arg a = .string, b = .string
  i = .int
  r = .string
  q = .string
  d = .int
  qd = .int
  if mag_cmp(a, b) < 0 then do
    px_ss[10] = "0"
    px_ss[11] = a
    return
  end
  r = "0"
  q = ""
  do i = 1 to length(a)
    r = mag_clean(r || substr(a, i, 1))
    qd = 0
    do while mag_cmp(r, b) >= 0
      r = mag_sub(r, b)
      qd = qd + 1
    end
    q = q || qd
  end
  px_ss[10] = mag_clean(q)
  px_ss[11] = r
  return

/* signed string helpers: s is "123" or "-123" */
sgn_split: procedure = .void
  arg s = .string
  if left(s, 1) == "-" then do
    px_si[75] = -1
    px_ss[12] = substr(s, 2)
  end
  else do
    px_si[75] = 1
    px_ss[12] = s
  end
  return

sgn_make: procedure = .string
  arg sgv = .int, mgv = .string
  if mgv == "0" then return "0"
  if sgv < 0 then return "-" || mgv
  return mgv

sadd: procedure = .string
  arg a = .string, b = .string
  sa = .int
  sb = .int
  ma = .string
  mb = .string
  c = .int
  call sgn_split a
  sa = px_si[75]
  ma = px_ss[12]
  call sgn_split b
  sb = px_si[75]
  mb = px_ss[12]
  if sa = sb then return sgn_make(sa, mag_add(ma, mb))
  c = mag_cmp(ma, mb)
  if c = 0 then return "0"
  if c > 0 then return sgn_make(sa, mag_sub(ma, mb))
  return sgn_make(sb, mag_sub(mb, ma))

sneg: procedure = .string
  arg a = .string
  if a == "0" then return "0"
  if left(a, 1) == "-" then return substr(a, 2)
  return "-" || a

ssub: procedure = .string
  arg a = .string, b = .string
  return sadd(a, sneg(b))

smul: procedure = .string
  arg a = .string, b = .string
  sa = .int
  sb = .int
  ma = .string
  mb = .string
  call sgn_split a
  sa = px_si[75]
  ma = px_ss[12]
  call sgn_split b
  sb = px_si[75]
  mb = px_ss[12]
  return sgn_make(sa * sb, mag_mul(ma, mb))

/* truncated quotient and remainder: results in sq, sr */
sdivmod: procedure = .void
  arg a = .string, b = .string
  sa = .int
  sb = .int
  ma = .string
  mb = .string
  call sgn_split a
  sa = px_si[75]
  ma = px_ss[12]
  call sgn_split b
  sb = px_si[75]
  mb = px_ss[12]
  call mag_divmod ma, mb
  px_ss[13] = sgn_make(sa * sb, px_ss[10])
  px_ss[14] = sgn_make(sa, px_ss[11])
  return

scmp: procedure = .int
  arg a = .string, b = .string
  sa = .int
  sb = .int
  ma = .string
  mb = .string
  call sgn_split a
  sa = px_si[75]
  ma = px_ss[12]
  call sgn_split b
  sb = px_si[75]
  mb = px_ss[12]
  if ma == "0" then sa = 0
  if mb == "0" then sb = 0
  if sa < sb then return -1
  if sa > sb then return 1
  if sa = 0 then return 0
  if sa > 0 then return mag_cmp(ma, mb)
  return mag_cmp(mb, ma)

/* decimal string of an integer oop (small or large) */
num_str: procedure = .string
  arg x = .int
  if x // 2 \= 0 then return intval(x) as .string
  return o_s[x % 2]

/* oop for an integer given as a decimal string */
big_norm: procedure = .int
  arg s0 = .string
  s = .string
  neg = .int
  o = .int
  s = s0
  neg = 0
  if left(s, 1) == "-" then do
    neg = 1
    s = substr(s, 2)
  end
  s = mag_clean(s)
  if length(s) <= 18 then do
    if neg = 1 then return mkint(0 - (s as .int))
    return mkint(s as .int)
  end
  if neg = 1 then s = "-" || s
  return mkbig(s)

mkbig: procedure = .int
  arg s = .string
  o = .int
  if length(s) <= 18 & left(s, 1) \== "-" then return mkint(s as .int)
  if length(s) <= 19 & left(s, 1) == "-" then return mkint(0 - (substr(s, 2) as .int))
  if left(s, 1) == "-" then o = newobj(px_si[55], 7, 0)
  else o = newobj(px_si[54], 7, 0)
  o_s[o % 2] = s
  return o

big_float: procedure = .float
  arg s = .string
  return s as .float

/* a float with a large magnitude -> integer string */
float_to_istr: procedure = .string
  arg x = .float
  s = .string
  p = .int
  e = .int
  m = .string
  neg = .int
  d = .int
  neg = 0
  if x < 0.0 then do
    neg = 1
    x = 0.0 - x
  end
  s = upper(x as .string)
  p = pos("E", s)
  if p = 0 then do
    d = pos(".", s)
    if d > 0 then s = left(s, d - 1)
    return sgn_make2(neg, s)
  end
  e = substr(s, p + 1) as .int
  m = left(s, p - 1)
  d = pos(".", m)
  if d > 0 then do
    e = e - (length(m) - d)
    m = left(m, d - 1) || substr(m, d + 1)
  end
  if e >= 0 then m = m || copies("0", e)
  else m = left(m, max(length(m) + e, 1))
  return sgn_make2(neg, mag_clean(m))

sgn_make2: procedure = .string
  arg neg = .int, m = .string
  if m == "0" | neg = 0 then return m
  return "-" || m

