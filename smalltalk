#!/bin/sh
# Launcher for the CREXX Smalltalk interpreter.
#   ./smalltalk [file.st ...]       run files (or standard input)
#   ./smalltalk -i [file.st ...]    run files, then an interactive prompt
#   ./smalltalk file.st -- a b      arguments after -- are in Smalltalk arguments
# The interpreter is compiled to bytecode on first use (about a minute),
# afterwards it starts quickly.  Set CREXX to the crexx driver if it is not on your PATH.
DIR=$(cd "$(dirname "$0")" && pwd)
CREXX=${CREXX:-crexx}
if [ ! -f "$DIR/smalltalk.rxbin" ] || [ "$DIR/smalltalk.crexx" -nt "$DIR/smalltalk.rxbin" ]; then
  echo "smalltalk: compiling interpreter (first run only)..." >&2
  "$CREXX" "$DIR/smalltalk.crexx" -noexec >/dev/null 2>&1 || {
    echo "smalltalk: compilation failed - run: $CREXX $DIR/smalltalk.crexx -noexec" >&2
    exit 2
  }
fi
exec "$CREXX" "$DIR/smalltalk.crexx" -nocompile -args -L "$DIR/lib" "$@"
